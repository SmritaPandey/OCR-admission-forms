{
    "name": "ocr-admission-forms-desktop",
    "productName": "OCR Form Extractor",
    "version": "1.0.0",
    "description": "Desktop application for OCR processing of admission forms",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder",
        "pack": "electron-builder --dir"
    },
    "keywords": [
        "Electron",
        "OCR",
        "FastAPI",
        "Next.js"
    ],
    "author": "Smrita Pandey",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "https://github.com/SmritaPandey/OCR-admission-forms"
    },
    "devDependencies": {
        "electron": "^28.1.0",
        "electron-builder": "^24.9.1"
    },
    "dependencies": {
        "tree-kill": "^1.2.2"
    },
    "build": {
        "appId": "com.smrita.ocrformextractor",
        "publish": null,
        "win": {
            "target": "nsis",
            "icon": "resources/icon.ico"
        },
        "mac": {
            "target": "dmg",
            "icon": "resources/icon.icns"
        },
        "linux": {
            "target": "AppImage",
            "icon": "resources/icon.png"
        },
        "files": [
            "**/*",
            "!**/*.ts",
            "!*.map"
        ],
        "extraResources": [
            {
                "from": "../backend-dist/api",
                "to": "backend",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../.next/standalone",
                "to": "standalone",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../.next/static",
                "to": "standalone/.next/static",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../public",
                "to": "standalone/public",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../admission_forms.db",
                "to": "data/admission_forms.db"
            },
            {
                "from": "../.env",
                "to": "data/.env"
            },
            {
                "from": "../uploads",
                "to": "data/uploads",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../google-cloud-credentials.json",
                "to": "data/google-cloud-credentials.json"
            }
        ]
    }
}