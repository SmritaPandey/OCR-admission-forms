{
    "name": "ocr-admission-forms-desktop",
    "productName": "OCR Form Extractor",
    "version": "1.0.0",
    "description": "Desktop application for OCR processing of admission forms",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder",
        "pack": "electron-builder --dir"
    },
    "keywords": [
        "Electron",
        "OCR",
        "FastAPI",
        "Next.js"
    ],
    "author": "Smrita Pandey",
    "license": "ISC",
    "devDependencies": {
        "electron": "^28.1.0",
        "electron-builder": "^24.9.1"
    },
    "dependencies": {
        "tree-kill": "^1.2.2"
    },
    "build": {
        "appId": "com.smrita.ocrformextractor",
        "win": {
            "target": "nsis",
            "icon": "resources/icon.ico"
        },
        "mac": {
            "target": "dmg",
            "icon": "resources/icon.icns"
        },
        "linux": {
            "target": "AppImage",
            "icon": "resources/icon.png"
        },
        "files": [
            "**/*",
            "!**/*.ts",
            "!*.map"
        ],
        "extraResources": [
            {
                "from": "../backend-dist/api",
                "to": "backend",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../.next",
                "to": ".next",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../node_modules",
                "to": "node_modules",
                "filter": [
                    "next/**/*",
                    "react/**/*",
                    "react-dom/**/*"
                ]
            },
            {
                "from": "../package.json",
                "to": "package.json"
            },
            {
                "from": "../next.config.ts",
                "to": "next.config.ts"
            }
        ]
    }
}