# =============================================================================
# Student Admission Form OCR System - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite (default) - Easy setup, no additional configuration needed
# For production, use PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./admission_forms.db

# -----------------------------------------------------------------------------
# OCR Provider Configuration
# -----------------------------------------------------------------------------
# Default OCR provider: craft-trocr (best for handwritten forms)
# Options: tesseract, google-vision, azure-vision, craft-trocr, best (auto-select)
OCR_PROVIDER=craft-trocr

# Enable/Disable OCR Providers
OCR_ENABLE_TESSERACT=true
OCR_ENABLE_GOOGLE_VISION=true
OCR_ENABLE_GOOGLE_DOCUMENT_AI=true
OCR_ENABLE_TESSERACT_GOOGLE_COMBINED=true
OCR_ENABLE_AZURE_VISION=false
OCR_ENABLE_AZURE_FORM_RECOGNIZER=false
OCR_ENABLE_AWS_TEXTRACT=false
OCR_ENABLE_ABBYY=false
OCR_ENABLE_CRAFT_TROCR=true

# Optional: Benchmark specific providers (leave empty to benchmark all enabled)
OCR_BENCHMARK_PROVIDERS=

# -----------------------------------------------------------------------------
# OCR Preprocessing Configuration
# -----------------------------------------------------------------------------
# Enable preprocessing pipeline for better OCR accuracy
OCR_PREPROCESSING_ENABLED=true
OCR_PREPROCESSING_ENHANCE_CONTRAST=true
OCR_PREPROCESSING_CONTRAST_FACTOR=1.8
OCR_PREPROCESSING_DENOISE=true
OCR_PREPROCESSING_DENOISE_SIZE=3
OCR_PREPROCESSING_SHARPEN=true
OCR_PREPROCESSING_SHARPNESS_FACTOR=1.6
OCR_PREPROCESSING_SCALE_FACTOR=2.0
OCR_PREPROCESSING_MAX_DIMENSION=2400
OCR_PREPROCESSING_BINARIZE=true
OCR_PREPROCESSING_BINARIZE_THRESHOLD=-1

# -----------------------------------------------------------------------------
# Google Cloud Vision API
# -----------------------------------------------------------------------------
# Get API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLOUD_API_KEY=AIzaSyDaDNNA-zcen3_ePv4P5iq2C8SKuhlHBww
GOOGLE_CLOUD_PROJECT_ID=admission-ocr

# -----------------------------------------------------------------------------
# Google Cloud Document AI (Best for forms and handwriting)
# -----------------------------------------------------------------------------
# Project ID from your Google Cloud Console
GOOGLE_DOCUMENT_AI_PROJECT_ID=admission-ocr
GOOGLE_DOCUMENT_AI_LOCATION=us
# Processor ID from Document AI - create a Form Parser processor in console
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# Path to service account JSON file (relative to project root)
GOOGLE_APPLICATION_CREDENTIALS=google-cloud-credentials.json

# -----------------------------------------------------------------------------
# Azure Computer Vision
# -----------------------------------------------------------------------------
# Get from Azure Portal: https://portal.azure.com
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=

# -----------------------------------------------------------------------------
# Azure Form Recognizer (Best for structured forms)
# -----------------------------------------------------------------------------
# Get from Azure Portal: https://portal.azure.com
AZURE_FORM_RECOGNIZER_KEY=
AZURE_FORM_RECOGNIZER_ENDPOINT=
# Optional: Custom trained model ID (get from Document Intelligence Studio)
AZURE_FORM_RECOGNIZER_CUSTOM_MODEL_ID=

# -----------------------------------------------------------------------------
# AWS Textract
# -----------------------------------------------------------------------------
# Get from AWS Console: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# ABBYY FineReader
# -----------------------------------------------------------------------------
ABBYY_APPLICATION_ID=
ABBYY_PASSWORD=
ABBYY_SERVER_URL=

# -----------------------------------------------------------------------------
# OpenAI GPT-4 Vision
# -----------------------------------------------------------------------------
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=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
OPENAI_VISION_MODEL=gpt-4-vision-preview

# -----------------------------------------------------------------------------
# Anthropic Claude Vision
# -----------------------------------------------------------------------------
# Get API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------------------
# Ollama (Local Vision Models)
# -----------------------------------------------------------------------------
# Run Ollama locally: https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision

# -----------------------------------------------------------------------------
# CRAFT + TR-OCR Configuration
# -----------------------------------------------------------------------------
# Path to custom trained TR-OCR model (optional)
# After training, set this to: models/trocr_student_forms
# Leave empty to use default microsoft/trocr-base-handwritten
TROCR_CUSTOM_MODEL_PATH=

# -----------------------------------------------------------------------------
# Batch Processing
# -----------------------------------------------------------------------------
BATCH_MAX_CONCURRENT=5
BATCH_QUEUE_BACKEND=memory

# -----------------------------------------------------------------------------
# OCR Caching
# -----------------------------------------------------------------------------
# Enable caching to avoid re-processing same images
OCR_CACHE_ENABLED=true

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "pdf", "tiff", "bmp"]

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Frontend URLs (automatically configured in config.py with regex pattern)
# No need to set CORS_ORIGINS here - handled in code

# -----------------------------------------------------------------------------
# Development/Production Settings
# -----------------------------------------------------------------------------
# Set to "production" for production deployment
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# 1. CRAFT+TR-OCR is enabled by default (best for handwritten forms)
# 2. Google Cloud credentials file should be at: google-cloud-credentials.json
# 3. After training a custom model, set TROCR_CUSTOM_MODEL_PATH=models/trocr_student_forms
# 4. For production, use PostgreSQL instead of SQLite
# 5. Enable only the OCR providers you need to reduce dependencies