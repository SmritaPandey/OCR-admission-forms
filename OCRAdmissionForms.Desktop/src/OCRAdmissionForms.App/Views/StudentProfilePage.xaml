<Page x:Class="OCRAdmissionForms.App.Views.StudentProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Student Profile"
      Background="#f0f2f5">
    <Page.Resources>
        <!-- Section Card Style -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#94a3b8" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <!-- Field Value -->
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1e293b" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Header Action Button Style -->
        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Background" Value="#15ffffff" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="#60ffffff" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30ffffff" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90ffffff" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40ffffff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Danger Button -->
        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource HeaderActionButton}">
            <Setter Property="Background" Value="#20ef4444" />
            <Setter Property="BorderBrush" Value="#80ef4444" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ GRADIENT HEADER ═══ -->
        <Border Grid.Row="0" CornerRadius="0,0,16,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1e3a5f" Offset="0" />
                    <GradientStop Color="#2563eb" Offset="0.5" />
                    <GradientStop Color="#3b82f6" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="32,20,32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button x:Name="BtnBack" Grid.Column="0" Click="Back_Click" 
                        Style="{StaticResource HeaderActionButton}" Margin="0,0,20,0">
                    <TextBlock Text="← Back" FontSize="13" Foreground="White"/>
                </Button>

                <!-- Avatar -->
                <Border Grid.Column="1" Width="64" Height="64" CornerRadius="32" Background="#ffffff30" Margin="0,0,20,0">
                    <TextBlock x:Name="TxtAvatar" Text="S" FontSize="28" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Name & Info -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStudentName" Text="Student Name" FontSize="26" FontWeight="Bold" Foreground="White" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="TxtCourse" Text="Course" FontSize="13" Foreground="#ffffffcc" Margin="0,0,16,0" />
                        <TextBlock x:Name="TxtRollNo" Text="Roll: —" FontSize="13" Foreground="#ffffffcc" Margin="0,0,16,0" />
                        <TextBlock x:Name="TxtAadhar" Text="Aadhar: —" FontSize="13" Foreground="#ffffffcc" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border x:Name="BadgeStatus" Background="#10b981" CornerRadius="10" Padding="10,3" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtStatus" Text="Verified" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <Border x:Name="BadgeCategory" Background="#3b82f6" CornerRadius="10" Padding="10,3">
                            <TextBlock x:Name="TxtCategory" Text="GEN" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnEdit" Click="Edit_Click" Style="{StaticResource HeaderActionButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏️" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Edit" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnExport" Click="Export_Click" Style="{StaticResource HeaderActionButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Export PDF" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPrint" Click="Print_Click" Style="{StaticResource HeaderActionButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Print" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDelete" Click="Delete_Click" Style="{StaticResource DangerActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Delete" FontSize="13" FontWeight="SemiBold" Foreground="#fca5a5"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ SCROLLABLE CONTENT ═══ -->
        <ScrollViewer Grid.Row="1" Padding="32,24,32,32">
            <ui:SimpleStackPanel Spacing="0">

                <!-- ═══ STAT CARDS ROW ═══ -->
                <ui:SimpleStackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,20">
                    <Border Background="White" CornerRadius="12" Padding="20,16" Width="160">
                        <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="TxtFormCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#1e3a5f" />
                            <TextBlock Text="Forms" FontSize="12" Foreground="#94a3b8" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="20,16" Width="160">
                        <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="TxtDocCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#2563eb" />
                            <TextBlock Text="Documents" FontSize="12" Foreground="#94a3b8" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="20,16" Width="160">
                        <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="TxtConfidence" Text="—%" FontSize="28" FontWeight="Bold" Foreground="#3b82f6" />
                            <TextBlock Text="Confidence" FontSize="12" Foreground="#94a3b8" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="12" Padding="20,16" Width="160">
                        <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06"/></Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="TxtFieldCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#60a5fa" />
                            <TextBlock Text="Fields Filled" FontSize="12" Foreground="#94a3b8" />
                        </StackPanel>
                    </Border>
                </ui:SimpleStackPanel>

                <!-- ═══ PERSONAL INFORMATION ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="👤  PERSONAL INFORMATION" FontSize="13" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,16" />
                        <ui:SimpleStackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="First Name" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValFirstName" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Middle Name" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValMiddleName" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Surname" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValSurname" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="Gender" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValGender" Style="{StaticResource FieldValue}"/></StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Date of Birth" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValDOB" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Blood Group" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValBloodGroup" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Religion" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValReligion" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="Nationality" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValNationality" Style="{StaticResource FieldValue}"/></StackPanel>
                            </Grid>
                                <StackPanel Grid.Column="0"><TextBlock Text="Aadhar Number" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValAadharNumber" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Below Poverty Line" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValBPL" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Annual Income" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValAnnualIncome" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="3"></StackPanel>
                        </ui:SimpleStackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ ACADEMIC INFORMATION ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="🎓  ACADEMIC &amp; ADMISSION" FontSize="13" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,16" />
                        <ui:SimpleStackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Course" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValCourse" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Academic Session" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValSession" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="College Roll No" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValCollegeRoll" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="CUET Score" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValCuetScore" Style="{StaticResource FieldValue}"/></StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Admission Category" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValAdmCat" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="DU Form Number" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValDUForm" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Date of Admission" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValDOA" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="DU Enrollment No" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValDUEnroll" Style="{StaticResource FieldValue}"/></StackPanel>
                            </Grid>
                        </ui:SimpleStackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ CONTACT INFORMATION ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="📞  CONTACT INFORMATION" FontSize="13" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,16" />
                        <ui:SimpleStackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Email" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValEmail" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValPhone" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Alternate Phone" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValAltPhone" Style="{StaticResource FieldValue}"/></StackPanel>
                            </Grid>
                        </ui:SimpleStackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ ADDRESS ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="🏠  ADDRESS" FontSize="13" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,16" />
                        <ui:SimpleStackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Permanent Address" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="ValPermAddress" Style="{StaticResource FieldValue}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <StackPanel Margin="0,0,24,0"><TextBlock Text="State" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValPermState" Style="{StaticResource FieldValue}"/></StackPanel>
                                        <StackPanel><TextBlock Text="Pincode" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValPermPincode" Style="{StaticResource FieldValue}"/></StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Correspondence Address" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="ValCorrAddress" Style="{StaticResource FieldValue}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <StackPanel Margin="0,0,24,0"><TextBlock Text="State" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValCorrState" Style="{StaticResource FieldValue}"/></StackPanel>
                                        <StackPanel><TextBlock Text="Pincode" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValCorrPincode" Style="{StaticResource FieldValue}"/></StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ui:SimpleStackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ PARENTS / GUARDIAN ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="👨‍👩‍👧  PARENTS &amp; GUARDIAN" FontSize="13" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,16" />
                        <ui:SimpleStackPanel Spacing="12">
                            <!-- Mother -->
                            <TextBlock Text="Mother's Details" FontSize="12" FontWeight="SemiBold" Foreground="#64748b" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValMotherName" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Occupation" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValMotherOcc" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Mobile" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValMotherMobile" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="Email" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValMotherEmail" Style="{StaticResource FieldValue}"/></StackPanel>
                            </Grid>
                            <!-- Father -->
                            <TextBlock Text="Father's Details" FontSize="12" FontWeight="SemiBold" Foreground="#64748b" Margin="0,8,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValFatherName" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Occupation" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValFatherOcc" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Mobile" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValFatherMobile" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="Email" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValFatherEmail" Style="{StaticResource FieldValue}"/></StackPanel>
                            </Grid>
                            <!-- Guardian -->
                            <TextBlock Text="Guardian Details" FontSize="12" FontWeight="SemiBold" Foreground="#64748b" Margin="0,8,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValGuardianName" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Relation" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValGuardianRel" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Mobile" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValGuardianMobile" Style="{StaticResource FieldValue}"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="Email" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValGuardianEmail" Style="{StaticResource FieldValue}"/></StackPanel>
                            </Grid>
                        </ui:SimpleStackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ CLASS XII & X ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="📚  EDUCATION HISTORY" FontSize="13" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,16" />
                        <TextBlock Text="Class XII" FontSize="12" FontWeight="SemiBold" Foreground="#64748b" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="Board" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Val12Board" Style="{StaticResource FieldValue}"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Year" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Val12Year" Style="{StaticResource FieldValue}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Percentage" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Val12Percent" Style="{StaticResource FieldValue}"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="Roll Number" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Val12Roll" Style="{StaticResource FieldValue}"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Institution" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Val12Institution" Style="{StaticResource FieldValue}"/></StackPanel>
                        </Grid>
                        <TextBlock Text="Class X" FontSize="12" FontWeight="SemiBold" Foreground="#64748b" Margin="0,16,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="Board" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Val10Board" Style="{StaticResource FieldValue}"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Year" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Val10Year" Style="{StaticResource FieldValue}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Percentage" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Val10Percent" Style="{StaticResource FieldValue}"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="School" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Val10School" Style="{StaticResource FieldValue}"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ EMERGENCY CONTACT ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="🚨  EMERGENCY CONTACT" FontSize="13" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValEmergName" Style="{StaticResource FieldValue}"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ValEmergPhone" Style="{StaticResource FieldValue}"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ FORMS LIST ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="📋  ADMISSION FORMS" FontSize="13" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,12" />
                        <DataGrid x:Name="FormsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="44"
                                  MouseDoubleClick="FormsGrid_DoubleClick" Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                                <DataGridTextColumn Header="Filename" Binding="{Binding Filename}" Width="*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                <DataGridTextColumn Header="Provider" Binding="{Binding OcrProvider}" Width="120" />
                                <DataGridTextColumn Header="Upload Date" Binding="{Binding UploadDate, StringFormat=d}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ═══ DOCUMENTS LIST ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="📎  DOCUMENTS" FontSize="13" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,12" />
                        <DataGrid x:Name="DocsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="44"
                                  Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                                <DataGridTextColumn Header="Filename" Binding="{Binding Filename}" Width="*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding DocumentCategory}" Width="120" />
                                <DataGridTextColumn Header="Upload Date" Binding="{Binding UploadDate, StringFormat=d}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </ui:SimpleStackPanel>
        </ScrollViewer>
    </Grid>
</Page>
