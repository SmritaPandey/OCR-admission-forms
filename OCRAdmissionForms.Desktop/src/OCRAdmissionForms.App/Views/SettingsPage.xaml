<Page x:Class="OCRAdmissionForms.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Settings"
      Background="#f0f2f5">
    <Page.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1e3a5f" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#64748b" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1e3a5f" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563eb" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#e2e8f0" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#e2e8f0" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#cbd5e1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="32,20" CornerRadius="0,0,16,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1e3a5f" Offset="0"/>
                    <GradientStop Color="#2563eb" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="⚙️  Settings" FontSize="26" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Configure application, database, sync, and user preferences" FontSize="13" Foreground="#ffffffcc" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="32,24,32,32">
            <ui:SimpleStackPanel Spacing="0" MaxWidth="900">

                <!-- ═══ 1. USER PROFILE ═══ -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="👤  User Profile" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Avatar -->
                            <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36" Background="#1e3a5f" Margin="0,0,24,0" VerticalAlignment="Top">
                                <TextBlock x:Name="TxtProfileAvatar" Text="A" FontSize="28" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Full Name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtProfileName" FontSize="14" Margin="0,0,0,8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtProfileEmail" FontSize="14" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Department" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtProfileDept" FontSize="14" Margin="0,0,0,8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Role" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock x:Name="TxtProfileRole" FontSize="14" Foreground="#64748b" Margin="0,4,0,8"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Save Profile" Click="SaveProfile_Click" Style="{StaticResource ActionBtn}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ 2. CHANGE PASSWORD ═══ -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="🔒  Change Password" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Current Password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="TxtCurrentPass" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="TxtNewPass" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Confirm Password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="TxtConfirmPass" FontSize="14"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Change Password" Click="ChangePassword_Click" Style="{StaticResource ActionBtn}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══ 3. USER MANAGEMENT (Admin) ═══ -->
                <Border x:Name="UserManagementPanel" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="👥  User Management (Admin)" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtNewUsername" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Full Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtNewFullName" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="TxtNewUserPass" FontSize="13"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="Add User" Click="AddUser_Click" Style="{StaticResource ActionBtn}" VerticalAlignment="Bottom"/>
                        </Grid>
                        <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="36"
                                  Background="Transparent" BorderThickness="0" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="80"/>
                                <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ═══ 4. DATABASE CONFIGURATION ═══ -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="🗄️  Database Configuration" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Database Location" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDbPath" Grid.Column="0" IsReadOnly="True" FontSize="13" Margin="0,0,8,0" Background="#f8fafc"/>
                            <Button Grid.Column="1" Content="Browse..." Click="BrowseDbPath_Click" Style="{StaticResource SecondaryBtn}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Apply &amp; Restart" Click="ApplyDbPath_Click" Style="{StaticResource ActionBtn}" Margin="0,0,8,0"/>
                            <Button Content="Reset to Default" Click="ResetDbPath_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                            <Button Content="Open Data Folder" Click="OpenDataFolder_Click" Style="{StaticResource SecondaryBtn}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ 5. SYNC CONFIGURATION ═══ -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="🔄  Sync Configuration" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="ChkSyncEnabled" Content="Enable synchronization with remote server" FontSize="13" Margin="0,0,0,12"
                                  Checked="SyncEnabled_Changed" Unchecked="SyncEnabled_Changed"/>
                        <TextBlock Text="Server URL" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtSyncUrl" FontSize="13" Margin="0,0,0,8"
                                 ui:ControlHelper.PlaceholderText="https://your-server.com/api/sync"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Auto-sync interval (minutes): " VerticalAlignment="Center" FontSize="13" Foreground="#475569"/>
                            <TextBox x:Name="TxtSyncInterval" Grid.Column="1" Width="80" FontSize="13" Text="5" HorizontalAlignment="Left"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Save Sync Settings" Click="SaveSyncSettings_Click" Style="{StaticResource ActionBtn}" Margin="0,0,8,0"/>
                            <Button Content="Sync Now" Click="SyncNow_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                            <Button Content="Test Connection" Click="TestSync_Click" Style="{StaticResource SecondaryBtn}"/>
                        </StackPanel>
                        <!-- Sync Status -->
                        <Border Background="#f8fafc" CornerRadius="8" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="SyncIndicator" Grid.Column="0" Width="10" Height="10" Fill="#94a3b8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtSyncStatus" Grid.Column="1" Text="Sync not configured" FontSize="12" Foreground="#64748b" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtLastSync" Grid.Column="2" Text="" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ 6. BACKUP & RESTORE ═══ -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="💾  Backup &amp; Restore" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Create a backup of your database or restore from a previous backup." FontSize="13" Foreground="#64748b" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export Backup" Click="ExportBackup_Click" Style="{StaticResource ActionBtn}" Margin="0,0,8,0"/>
                            <Button Content="Import Backup" Click="ImportBackup_Click" Style="{StaticResource SecondaryBtn}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ 7. GOOGLE CLOUD OCR ═══ -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="☁️  Google Cloud Vision API" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Credentials File" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCredentialPath" Grid.Column="0" IsReadOnly="True" FontSize="13" Margin="0,0,8,0" Background="#f8fafc"/>
                            <Button Grid.Column="1" Content="Browse..." Click="BrowseCredentials_Click" Style="{StaticResource SecondaryBtn}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CredentialStatusBadge" Background="#fef2f2" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtCredentialStatus" Text="Not Configured" FontSize="11" Foreground="#ef4444"/>
                            </Border>
                            <Button Content="Test OCR" Click="TestOcr_Click" Style="{StaticResource SecondaryBtn}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ 8. GEMINI AI ═══ -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="✨  Gemini AI API Key" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Used for AI-powered extraction and data enrichment." FontSize="13" Foreground="#64748b" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtGeminiKey" Grid.Column="0" FontSize="13" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Save Key" Click="SaveGeminiKey_Click" Style="{StaticResource ActionBtn}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ 9. ABOUT ═══ -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="ℹ️  About" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="SRCC Student Document Management System" FontSize="14" FontWeight="SemiBold" Foreground="#1e3a5f"/>
                        <TextBlock Text="Version 2.0.0  •  © 2026 Shri Ram College of Commerce" FontSize="12" Foreground="#94a3b8" Margin="0,4,0,8"/>
                        <Border Background="#fffbeb" CornerRadius="8" Padding="12,8">
                            <TextBlock Text="Default Admin: admin / admin123 (change on first login)" FontSize="12" Foreground="#92400e"/>
                        </Border>
                    </StackPanel>
                </Border>

            </ui:SimpleStackPanel>
        </ScrollViewer>
    </Grid>
</Page>
