<Page x:Class="OCRAdmissionForms.App.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Login">
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Login Card -->
        <Border VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                Width="400"
                Background="White"
                CornerRadius="12"
                Padding="32">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="20" Opacity="0.15" />
            </Border.Effect>
            
            <StackPanel>
                <!-- Logo with white background -->
                <Border Background="White" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
                    <Image Source="/Resources/srcc-logo.png" 
                           Height="60" 
                           Stretch="Uniform" 
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                
                <!-- Title -->
                <TextBlock Text="Student Document" 
                           FontSize="20" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" 
                           Margin="0,16,0,0" />
                <TextBlock Text="Management System" 
                           FontSize="20" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Sign in to continue" 
                           FontSize="13" 
                           Foreground="#6B7280"
                           HorizontalAlignment="Center" 
                           Margin="0,8,0,24" />
                
                <!-- Error Message -->
                <Border x:Name="ErrorPanel" 
                        Background="#FEE2E2" 
                        BorderBrush="#F87171" 
                        BorderThickness="1"
                        CornerRadius="6" 
                        Padding="12,8" 
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" 
                               Text="" 
                               Foreground="#DC2626" 
                               FontSize="13"
                               TextWrapping="Wrap" />
                </Border>
                
                <!-- Username -->
                <TextBlock Text="Username" 
                           Foreground="{StaticResource TextBrush}" 
                           FontSize="13" 
                           FontWeight="Medium"
                           Margin="0,0,0,6" />
                <TextBox x:Name="TxtUsername" 
                         Padding="12,10"
                         FontSize="14"
                         ui:ControlHelper.PlaceholderText="Enter username" />
                
                <!-- Password -->
                <TextBlock Text="Password" 
                           Foreground="{StaticResource TextBrush}" 
                           FontSize="13" 
                           FontWeight="Medium"
                           Margin="0,16,0,6" />
                <PasswordBox x:Name="TxtPassword" 
                             Padding="12,10"
                             FontSize="14"
                             ui:ControlHelper.PlaceholderText="Enter password" />
                
                <!-- Remember Me -->
                <CheckBox x:Name="ChkRemember" 
                          Content="Remember me" 
                          Margin="0,16,0,0" 
                          FontSize="13" />
                
                <!-- Login Button -->
                <Button x:Name="BtnLogin" 
                        Click="Login_Click"
                        HorizontalAlignment="Stretch"
                        Margin="0,24,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Padding="0,14">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Contact" Margin="0,0,8,0" />
                        <TextBlock Text="Sign In" FontSize="15" />
                    </StackPanel>
                </Button>
                
                <!-- Offline Indicator -->
                <Border x:Name="OfflinePanel" 
                        Background="#FEF3C7" 
                        CornerRadius="6" 
                        Padding="12,8" 
                        Margin="0,16,0,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0" />
                        <TextBlock Text="Offline mode - Using cached credentials" 
                                   Foreground="#92400E" 
                                   FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        
        <!-- Footer -->
        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    Margin="0,0,0,24">
            <TextBlock Text="© 2026 Shri Ram College of Commerce" 
                       FontSize="12" 
                       Foreground="#9CA3AF"
                       HorizontalAlignment="Center" />
            <TextBlock Text="University of Delhi" 
                       FontSize="11" 
                       Foreground="#9CA3AF"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</Page>
