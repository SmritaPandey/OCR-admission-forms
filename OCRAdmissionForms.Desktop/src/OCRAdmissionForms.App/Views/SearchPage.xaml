<Page x:Class="OCRAdmissionForms.App.Views.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Search">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Global Search" FontSize="28" FontWeight="Bold" Foreground="#1E3A5F" />
            <TextBlock Text="Search &amp; filter students, forms, and documents" FontSize="14" Foreground="#718096" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <TextBox x:Name="TxtSearch" Padding="12,14" FontSize="14" 
                     ui:ControlHelper.PlaceholderText="Search by name, roll number, Aadhar, phone, email, DU Form No..."
                     KeyDown="TxtSearch_KeyDown"/>
            
            <Button Grid.Column="1" x:Name="BtnSearch" Click="Search_Click" 
                    Margin="8,0,0,0" Padding="24,12" Background="#1E3A5F" Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Find" />
                    <TextBlock Text="Search" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            
            <Button Grid.Column="2" x:Name="BtnClear" Click="Clear_Click" 
                    Margin="8,0,0,0" Padding="16,12" Background="#E2E8F0">
                <ui:SymbolIcon Symbol="Cancel" />
            </Button>
        </Grid>

        <!-- ═══ FILTER BAR ═══ -->
        <Border Grid.Row="2" Background="#f0f4f8" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="⚙  FILTERS" FontSize="11" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,8" />
                <WrapPanel>
                    <!-- Status -->
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="Status" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbStatus" Width="130" FontSize="12" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True" />
                            <ComboBoxItem Content="Uploaded" />
                            <ComboBoxItem Content="Extracting" />
                            <ComboBoxItem Content="Extracted" />
                            <ComboBoxItem Content="Verified" />
                            <ComboBoxItem Content="Error" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Course -->
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="Course" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbCourse" Width="150" FontSize="12" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True" />
                            <ComboBoxItem Content="B.COM.(H)" />
                            <ComboBoxItem Content="B.A.(H) ECO" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Category -->
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="Category" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbCategory" Width="120" FontSize="12" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True" />
                            <ComboBoxItem Content="GEN" />
                            <ComboBoxItem Content="OBC" />
                            <ComboBoxItem Content="SC" />
                            <ComboBoxItem Content="ST" />
                            <ComboBoxItem Content="EWS" />
                            <ComboBoxItem Content="PwD" />
                            <ComboBoxItem Content="Sports" />
                            <ComboBoxItem Content="CW" />
                            <ComboBoxItem Content="KM" />
                            <ComboBoxItem Content="ECA" />
                            <ComboBoxItem Content="Foreign" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Gender -->
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="Gender" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbGender" Width="110" FontSize="12" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True" />
                            <ComboBoxItem Content="Male" />
                            <ComboBoxItem Content="Female" />
                            <ComboBoxItem Content="Transgender" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Religion -->
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="Religion" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbReligion" Width="120" FontSize="12" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True" />
                            <ComboBoxItem Content="Hindu" />
                            <ComboBoxItem Content="Muslim" />
                            <ComboBoxItem Content="Sikh" />
                            <ComboBoxItem Content="Jain" />
                            <ComboBoxItem Content="Christian" />
                            <ComboBoxItem Content="Buddhist" />
                            <ComboBoxItem Content="Persian" />
                            <ComboBoxItem Content="Others" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Blood Group -->
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="Blood Group" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbBloodGroup" Width="100" FontSize="12" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True" />
                            <ComboBoxItem Content="A+" />
                            <ComboBoxItem Content="A-" />
                            <ComboBoxItem Content="B+" />
                            <ComboBoxItem Content="B-" />
                            <ComboBoxItem Content="AB+" />
                            <ComboBoxItem Content="AB-" />
                            <ComboBoxItem Content="O+" />
                            <ComboBoxItem Content="O-" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Nationality -->
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="Nationality" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbNationality" Width="110" FontSize="12" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True" />
                            <ComboBoxItem Content="Indian" />
                            <ComboBoxItem Content="Other" />
                        </ComboBox>
                    </StackPanel>

                    <!-- BPL -->
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="BPL" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbBPL" Width="80" FontSize="12" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True" />
                            <ComboBoxItem Content="Yes" />
                            <ComboBoxItem Content="No" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Clear Filters -->
                    <Button x:Name="BtnClearFilters" Click="ClearFilters_Click" 
                            Padding="14,8" Margin="0,14,0,0" Background="#e2e8f0" VerticalAlignment="Bottom"
                            ToolTip="Reset all filters">
                        <TextBlock Text="✕ Clear Filters" FontSize="11" />
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Results Tabs -->
        <TabControl Grid.Row="3" x:Name="ResultsTabs">
            <!-- Students Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Contact" />
                        <TextBlock x:Name="TxtStudentCount" Text="Students (0)" Margin="8,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <Border Background="White" CornerRadius="0,8,8,8" Padding="16" Margin="0,8,0,0">
                    <DataGrid x:Name="StudentsGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="48"
                              MouseDoubleClick="StudentsGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="Student Name" Binding="{Binding StudentName}" Width="*" />
                            <DataGridTextColumn Header="Roll Number" Binding="{Binding RollNumber}" Width="120" />
                            <DataGridTextColumn Header="Aadhar" Binding="{Binding AadharNumber}" Width="150" />
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedDate, StringFormat=dd/MM/yyyy}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            
            <!-- Forms Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Document" />
                        <TextBlock x:Name="TxtFormCount" Text="Forms (0)" Margin="8,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <Border Background="White" CornerRadius="0,8,8,8" Padding="16" Margin="0,8,0,0">
                    <DataGrid x:Name="FormsGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="48"
                              MouseDoubleClick="FormsGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="Student Name" Binding="{Binding StudentName}" Width="*" />
                            <DataGridTextColumn Header="Roll No" Binding="{Binding CollegeRollNo}" Width="100" />
                            <DataGridTextColumn Header="Course" Binding="{Binding Course}" Width="120" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="80" />
                            <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="70" />
                            <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="110" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                            <DataGridTextColumn Header="Upload Date" Binding="{Binding UploadDate, StringFormat=dd/MM/yyyy}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="#F7FAFC" CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Enter a search term or use filters to begin" Foreground="#718096" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnExport" Click="Export_Click" Background="#D4AF37" Foreground="White" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save" />
                            <TextBlock Text="Export Results" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPrint" Click="Print_Click" Margin="8,0,0,0" Background="#800020" Foreground="White" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Print" />
                            <TextBlock Text="Print" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
