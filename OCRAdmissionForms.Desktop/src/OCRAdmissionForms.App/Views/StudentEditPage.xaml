<Page x:Class="OCRAdmissionForms.App.Views.StudentEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Title="Edit Student">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition Width="460" />
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: DOCUMENT PREVIEW ═══ -->
        <Border Grid.Column="0" Background="#1e293b">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Zoom Controls -->
                <Border Grid.Row="0" Padding="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1e3a5f" Offset="0" />
                            <GradientStop Color="#2563eb" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnZoomOut" Click="ZoomOut_Click" Padding="12,8" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="−" FontSize="18" FontWeight="Bold" />
                        </Button>
                        <TextBlock x:Name="TxtZoomLevel" Text="100%" Foreground="White" VerticalAlignment="Center" Margin="16,0" FontWeight="SemiBold" />
                        <Button x:Name="BtnZoomIn" Click="ZoomIn_Click" Padding="12,8" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="+" FontSize="18" FontWeight="Bold" />
                        </Button>
                        <Button x:Name="BtnZoomFit" Click="ZoomFit_Click" Padding="12,8" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="16,0,0,0">
                            <TextBlock Text="Fit" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Document Viewer -->
                <Grid Grid.Row="1" Background="#0f172a">
                    <ScrollViewer x:Name="ImageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="FormImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" />
                    </ScrollViewer>
                    <wv2:WebView2 x:Name="PdfViewer" Visibility="Collapsed" />
                    <TextBlock x:Name="TxtNoPreview" Text="No document preview available" Foreground="#94a3b8" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="Collapsed" Margin="40" />
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ RIGHT: EDIT FORM ═══ -->
        <Border Grid.Column="1" Background="#f8fafc">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="16,14,16,12" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1e3a5f" Offset="0" />
                            <GradientStop Color="#2563eb" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnCancel" Click="Cancel_Click" Padding="6,4" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="← Back" FontSize="12" Foreground="#cbd5e1" />
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TxtEditTitle" Text="Edit Student Profile" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock x:Name="TxtEditSubtitle" Text="Make changes and save" FontSize="11" Foreground="#93c5fd" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Scrollable Form -->
                <ScrollViewer Grid.Row="1" Padding="16,12,16,16">
                    <ui:SimpleStackPanel Spacing="14">

                        <!-- ═══ PERSONAL ═══ -->
                        <Border Background="White" CornerRadius="10" Padding="16">
                            <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.04"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="👤  PERSONAL" FontSize="12" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,10" />
                                <ui:SimpleStackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="First Name *" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdFirstName" FontSize="12"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Middle Name" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdMiddleName" FontSize="12"/></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="Surname" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdSurname" FontSize="12"/></StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="Gender" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="EdGender" HorizontalAlignment="Stretch" FontSize="12">
                                                <ComboBoxItem Content="Male"/><ComboBoxItem Content="Female"/><ComboBoxItem Content="Transgender"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Date of Birth" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdDOB" FontSize="12" ui:ControlHelper.PlaceholderText="DD/MM/YYYY"/></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="Blood Group" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="EdBloodGroup" HorizontalAlignment="Stretch" FontSize="12">
                                                <ComboBoxItem Content="A+"/><ComboBoxItem Content="A-"/><ComboBoxItem Content="B+"/><ComboBoxItem Content="B-"/>
                                                <ComboBoxItem Content="AB+"/><ComboBoxItem Content="AB-"/><ComboBoxItem Content="O+"/><ComboBoxItem Content="O-"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="Religion" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="EdReligion" HorizontalAlignment="Stretch" FontSize="12">
                                                <ComboBoxItem Content="Hindu"/><ComboBoxItem Content="Muslim"/><ComboBoxItem Content="Sikh"/><ComboBoxItem Content="Jain"/>
                                                <ComboBoxItem Content="Christian"/><ComboBoxItem Content="Buddhist"/><ComboBoxItem Content="Persian"/><ComboBoxItem Content="Others"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Nationality" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="EdNationality" HorizontalAlignment="Stretch" FontSize="12">
                                                <ComboBoxItem Content="Indian"/><ComboBoxItem Content="Other"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="Aadhar" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdAadhar" FontSize="12" MaxLength="12"/></StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="2"><TextBlock Text="BPL" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="EdBPL" HorizontalAlignment="Stretch" FontSize="12">
                                                <ComboBoxItem Content="Yes"/><ComboBoxItem Content="No"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="Annual Income" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdIncome" FontSize="12"/></StackPanel>
                                    </Grid>
                                </ui:SimpleStackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══ ACADEMIC ═══ -->
                        <Border Background="White" CornerRadius="10" Padding="16">
                            <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.04"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🎓  ACADEMIC" FontSize="12" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Course" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="EdCourse" HorizontalAlignment="Stretch" FontSize="12">
                                            <ComboBoxItem Content="B.COM.(H)"/><ComboBoxItem Content="B.A.(H) ECO"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Session" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdSession" FontSize="12" ui:ControlHelper.PlaceholderText="2024-25"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Roll No" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdCollegeRoll" FontSize="12"/></StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="CUET Score" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdCuetScore" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Category" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="EdCategory" HorizontalAlignment="Stretch" FontSize="12">
                                            <ComboBoxItem Content="GEN"/><ComboBoxItem Content="OBC"/><ComboBoxItem Content="SC"/>
                                            <ComboBoxItem Content="ST"/><ComboBoxItem Content="EWS"/><ComboBoxItem Content="PwD"/>
                                            <ComboBoxItem Content="Sports"/><ComboBoxItem Content="CW"/><ComboBoxItem Content="KM"/>
                                            <ComboBoxItem Content="ECA"/><ComboBoxItem Content="Foreign"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="DU Form No" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdDUForm" FontSize="12"/></StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Date of Admission" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdDOA" FontSize="12" ui:ControlHelper.PlaceholderText="DD/MM/YYYY"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="DU Enrollment No" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdDUEnroll" FontSize="12"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ CONTACT ═══ -->
                        <Border Background="White" CornerRadius="10" Padding="16">
                            <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.04"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📞  CONTACT" FontSize="12" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Email" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdEmail" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Phone" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdPhone" FontSize="12" MaxLength="10"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Alt Phone" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdAltPhone" FontSize="12" MaxLength="10"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ ADDRESS ═══ -->
                        <Border Background="White" CornerRadius="10" Padding="16">
                            <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.04"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🏠  ADDRESS" FontSize="12" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Permanent Address" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                                        <TextBox x:Name="EdPermAddress" AcceptsReturn="True" TextWrapping="Wrap" Height="50" FontSize="12"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="EdPermState" Grid.Column="0" FontSize="12" ui:ControlHelper.PlaceholderText="State"/>
                                            <TextBox x:Name="EdPermPincode" Grid.Column="2" FontSize="12" ui:ControlHelper.PlaceholderText="Pincode" MaxLength="6"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Correspondence Address" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/>
                                        <TextBox x:Name="EdCorrAddress" AcceptsReturn="True" TextWrapping="Wrap" Height="50" FontSize="12"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="EdCorrState" Grid.Column="0" FontSize="12" ui:ControlHelper.PlaceholderText="State"/>
                                            <TextBox x:Name="EdCorrPincode" Grid.Column="2" FontSize="12" ui:ControlHelper.PlaceholderText="Pincode" MaxLength="6"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ PARENTS & GUARDIAN ═══ -->
                        <Border Background="White" CornerRadius="10" Padding="16">
                            <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.04"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="👨‍👩‍👧  PARENTS &amp; GUARDIAN" FontSize="12" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,10" />
                                <TextBlock Text="Mother" FontSize="11" FontWeight="SemiBold" Foreground="#1e3a5f" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Name" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="EdMotherName" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Occupation" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="EdMotherOcc" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Mobile" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="EdMotherMobile" FontSize="12" MaxLength="10"/></StackPanel>
                                    <StackPanel Grid.Column="6"><TextBlock Text="Email" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="EdMotherEmail" FontSize="12"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Father" FontSize="11" FontWeight="SemiBold" Foreground="#1e3a5f" Margin="0,10,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Name" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="EdFatherName" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Occupation" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="EdFatherOcc" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Mobile" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="EdFatherMobile" FontSize="12" MaxLength="10"/></StackPanel>
                                    <StackPanel Grid.Column="6"><TextBlock Text="Email" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="EdFatherEmail" FontSize="12"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Guardian" FontSize="11" FontWeight="SemiBold" Foreground="#1e3a5f" Margin="0,10,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Name" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="EdGuardianName" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Relation" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="EdGuardianRel" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Mobile" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="EdGuardianMobile" FontSize="12" MaxLength="10"/></StackPanel>
                                    <StackPanel Grid.Column="6"><TextBlock Text="Email" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="EdGuardianEmail" FontSize="12"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ EDUCATION ═══ -->
                        <Border Background="White" CornerRadius="10" Padding="16">
                            <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.04"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📚  EDUCATION" FontSize="12" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,10" />
                                <TextBlock Text="Class XII" FontSize="11" FontWeight="SemiBold" Foreground="#1e3a5f" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Board" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="Ed12Board" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Year" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="Ed12Year" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="%" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="Ed12Percent" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="6"><TextBlock Text="Roll" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="Ed12Roll" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="8"><TextBlock Text="Institution" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="Ed12Institution" FontSize="12"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Class X" FontSize="11" FontWeight="SemiBold" Foreground="#1e3a5f" Margin="0,10,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Board" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="Ed10Board" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Year" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="Ed10Year" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="%" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="Ed10Percent" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="6"><TextBlock Text="School" FontSize="10" Foreground="#94a3b8" Margin="0,0,0,3"/><TextBox x:Name="Ed10School" FontSize="12"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ EMERGENCY ═══ -->
                        <Border Background="White" CornerRadius="10" Padding="16">
                            <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.04"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🚨  EMERGENCY" FontSize="12" FontWeight="Bold" Foreground="#1e3a5f" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Name" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdEmergName" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Phone" FontSize="10" Foreground="#64748b" Margin="0,0,0,3"/><TextBox x:Name="EdEmergPhone" FontSize="12" MaxLength="10"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </ui:SimpleStackPanel>
                </ScrollViewer>

                <!-- Footer Action Bar -->
                <Border Grid.Row="2" Padding="12,10" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#f8fafc" Offset="0" />
                            <GradientStop Color="#f1f5f9" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtSaveStatus" Text="Edit fields and save" FontSize="11" Foreground="#64748b" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="BtnAttach" Click="AttachDocument_Click" Padding="18,8" Margin="0,0,8,0" Cursor="Hand"
                                Background="#6366f1" Foreground="White" ToolTip="Attach supporting documents">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📎" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Attach" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="BtnSave" Click="Save_Click" Padding="18,8" Margin="0,0,8,0" Cursor="Hand"
                                Background="#2563eb" Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Save" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" x:Name="BtnVerify" Click="Verify_Click" Padding="18,8" Cursor="Hand"
                                Background="#10b981" Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" FontSize="13" FontWeight="Bold" Margin="0,0,6,0" />
                                <TextBlock Text="Save &amp; Verify" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Page>
