<Page x:Class="OCRAdmissionForms.App.Views.BatchUploadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Batch Upload">
    <Grid Margin="32" Background="#f1f5f9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Batch Upload Forms" FontSize="28" FontWeight="Bold" Foreground="#1a3a6e" />
            <TextBlock Text="Upload multiple PDF forms at once. Perfect for processing large volumes of admission forms." 
                       FontSize="14" Foreground="#718096" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Options -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Form Pages (first N pages)" FontSize="12" Foreground="#718096" />
                    <TextBox x:Name="TxtFormPages" Text="4" Margin="0,4,0,0" Width="80" HorizontalAlignment="Left" />
                    <TextBlock Text="First 4 pages = admission form, remaining = documents" FontSize="11" Foreground="#a0aec0" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="OCR Provider" FontSize="12" Foreground="#718096" />
                    <ComboBox x:Name="CmbProvider" Margin="0,4,0,0" Width="220" HorizontalAlignment="Left">
                        <ComboBoxItem Content="🤖 Gemini AI (Best)" Tag="gemini" IsSelected="True" />
                        <ComboBoxItem Content="🔬 Enhanced Vision" Tag="enhanced" />
                        <ComboBoxItem Content="🎯 Multi-Provider" Tag="multi" />
                        <ComboBoxItem Content="📐 Basic Spatial" Tag="spatial" />
                    </ComboBox>
                    <CheckBox x:Name="ChkAutoVerify" Content="Auto-verify forms with confidence ≥ 85%" 
                              IsChecked="True" Margin="0,8,0,0" FontSize="12" Foreground="#64748b" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- Files List -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkSelectAll" Checked="SelectAll_Click" Unchecked="DeselectAll_Click" 
                                  Content="Select All" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtFileCount" Text="Selected Files (0)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnAddFiles" Click="AddFiles_Click" Padding="16,8" Background="#2563eb" Foreground="White" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add" Margin="0,0,8,0" />
                                <TextBlock Text="Add PDFs" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAddFolder" Click="AddFolder_Click" Padding="16,8" Background="#7c3aed" Foreground="White" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder" Margin="0,0,8,0" />
                                <TextBlock Text="Select Folder" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnClearAll" Click="ClearAll_Click" Padding="16,8">
                            <TextBlock Text="Clear All" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ListBox x:Name="FilesList" Grid.Row="1" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="#718096" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#10b981" VerticalAlignment="Center" Margin="16,0" />
                                <Button Grid.Column="2" Click="RemoveFile_Click" Tag="{Binding Path}" Padding="8,4" Background="Transparent">
                                    <ui:SymbolIcon Symbol="Cancel" Foreground="#ef4444" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Actions -->
        <Border Grid.Row="3" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Progress -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <TextBlock x:Name="TxtProgressStatus" Text="Processing..." FontWeight="SemiBold" />
                    <ui:ProgressBar x:Name="ProgressBar" Margin="0,8,16,0" />
                    <TextBlock x:Name="TxtProgressDetail" FontSize="12" Foreground="#718096" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnProcess" Click="Process_Click" Padding="32,12" 
                        Background="#10b981" Foreground="White" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtProcessButton" Text="Process All" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
