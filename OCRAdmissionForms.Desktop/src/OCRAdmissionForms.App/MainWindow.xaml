<Window x:Class="OCRAdmissionForms.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="SRCC Student Document Management System"
        Height="850" Width="1500"
        MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SRCC Themed Sidebar -->
        <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <!-- Logo Header -->
                <Border DockPanel.Dock="Top" Padding="20" Background="#152D4A">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="4" Opacity="0.2" Direction="270" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- Logo with white background -->
                        <Border Background="White" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
                            <Image Source="/Resources/srcc-logo.png" 
                                   Height="60" 
                                   Stretch="Uniform" 
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="Student Document" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="White" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,12,0,0" />
                        <TextBlock Text="Management System" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="White" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- User Info (if logged in) -->
                <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#2A4A6F" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{StaticResource SrccMaroon}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Grid.Column="0" Text="A" 
                                   Foreground="White" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtUserName" Text="Admin User" 
                                       Foreground="White" 
                                       FontWeight="SemiBold" 
                                       FontSize="14" />
                            <TextBlock x:Name="TxtUserRole" Text="Administrator" 
                                       Foreground="#A0AEC0" 
                                       FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" Padding="16" Background="#152D4A">
                    <StackPanel>
                        <!-- Sync Status -->
                        <Border Background="#1E3A5F" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="SidebarSyncDot" Grid.Column="0" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,8,0" />
                                <TextBlock x:Name="TxtSidebarSyncLabel" Grid.Column="1" Text="Offline" Foreground="#A0AEC0" FontSize="12" />
                                <TextBlock x:Name="TxtSidebarSyncStatus" Grid.Column="2" Text="—" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <TextBlock Text="© 2026 Shri Ram College of Commerce" 
                                   FontSize="10" 
                                   Foreground="#718096" 
                                   HorizontalAlignment="Center" 
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16">
                        <!-- MAIN Section -->
                        <TextBlock Text="MAIN" 
                                   FontSize="11" 
                                   Foreground="#718096" 
                                   Margin="24,0,0,8" 
                                   FontWeight="Bold" />
                        
                        <Button x:Name="BtnDashboard" Click="NavButton_Click" Tag="Dashboard" Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home" Margin="0,0,14,0" />
                                <TextBlock Text="Dashboard" />
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="BtnStudents" Click="NavButton_Click" Tag="Students" Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People" Margin="0,0,14,0" />
                                <TextBlock Text="Students" />
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="BtnForms" Click="NavButton_Click" Tag="Forms" Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Document" Margin="0,0,14,0" />
                                <TextBlock Text="Admission Forms" />
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="BtnSearch" Click="NavButton_Click" Tag="Search" Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Find" Margin="0,0,14,0" />
                                <TextBlock Text="Search" />
                            </StackPanel>
                        </Button>

                        <!-- ACTIONS Section -->
                        <TextBlock Text="ACTIONS" 
                                   FontSize="11" 
                                   Foreground="#718096" 
                                   Margin="24,24,0,8" 
                                   FontWeight="Bold" />
                        
                        <Button x:Name="BtnUpload" Click="NavButton_Click" Tag="Upload" Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Upload" Margin="0,0,14,0" />
                                <TextBlock Text="Upload Form" />
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="BtnBatchUpload" Click="NavButton_Click" Tag="BatchUpload" Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Library" Margin="0,0,14,0" />
                                <TextBlock Text="Batch Import" />
                            </StackPanel>
                        </Button>

                        <!-- REPORTS Section -->
                        <TextBlock Text="REPORTS" 
                                   FontSize="11" 
                                   Foreground="#718096" 
                                   Margin="24,24,0,8" 
                                   FontWeight="Bold" />
                        
                        <Button x:Name="BtnExport" Click="NavButton_Click" Tag="Export" Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Download" Margin="0,0,14,0" />
                                <TextBlock Text="Export Data" />
                            </StackPanel>
                        </Button>

                        <!-- SYSTEM Section -->
                        <TextBlock Text="SYSTEM" 
                                   FontSize="11" 
                                   Foreground="#718096" 
                                   Margin="24,24,0,8" 
                                   FontWeight="Bold" />
                        
                        <Button x:Name="BtnSettings" Click="NavButton_Click" Tag="Settings" Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Setting" Margin="0,0,14,0" />
                                <TextBlock Text="Settings" />
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="BtnLogout" Click="Logout_Click" Style="{StaticResource SidebarButton}" Foreground="#F87171">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Back" Margin="0,0,14,0" />
                                <TextBlock Text="Logout" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- Page Content Frame -->
                <Frame x:Name="ContentFrame" Grid.Row="0" NavigationUIVisibility="Hidden" />
                
                <!-- Global Batch Upload Progress Bar -->
                <Border x:Name="GlobalProgressPanel" Grid.Row="1" 
                        Background="{StaticResource PrimaryBrush}" 
                        Padding="20,14" 
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.3" Direction="90" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Icon -->
                        <ui:SymbolIcon Grid.Column="0" Symbol="Library" Foreground="White" Margin="0,0,16,0" />
                        
                        <!-- Progress Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <DockPanel>
                                <TextBlock x:Name="TxtGlobalStatus" Text="Processing batch upload..." 
                                           Foreground="White" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="TxtGlobalProgress" Text="0 / 0 forms" 
                                           Foreground="#A0AEC0" FontSize="12" HorizontalAlignment="Right" Margin="16,0,0,0" />
                            </DockPanel>
                            <ProgressBar x:Name="GlobalProgressBar" 
                                         Height="6" 
                                         Margin="0,8,0,0" 
                                         Minimum="0" Maximum="100" Value="0"
                                         Foreground="{StaticResource AccentBrush}" Background="#2A4A6F" />
                        </StackPanel>
                        
                        <!-- Stats -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                            <TextBlock Text="✓ " Foreground="#34D399" FontSize="14" />
                            <TextBlock x:Name="TxtGlobalSuccess" Text="0" Foreground="#34D399" FontSize="14" FontWeight="Bold" Margin="0,0,16,0" />
                            <TextBlock Text="✗ " Foreground="#F87171" FontSize="14" />
                            <TextBlock x:Name="TxtGlobalFailed" Text="0" Foreground="#F87171" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                        
                        <!-- View Button -->
                        <Button x:Name="BtnViewBatchUpload" Grid.Column="3" 
                                Click="ViewBatchUpload_Click"
                                Style="{StaticResource PrimaryButton}"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="View" Margin="0,0,8,0" />
                                <TextBlock Text="View Details" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
