@page "/students/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using OCRAdmissionForms.Core.Entities
@using OCRAdmissionForms.Core.Enums
@using OCRAdmissionForms.Infrastructure.Data
@inject AppDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Student Profile - @(student?.StudentName ?? "Loading...")</PageTitle>

@if (student == null)
{
    <div class="p-5 text-center">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-secondary">Loading student profile...</p>
    </div>
}
else
{
    <div class="container-fluid py-4">
        <!-- Back + Actions -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <button class="btn btn-outline-secondary rounded-pill px-4" @onclick='() => Navigation.NavigateTo("students")'>
                <span class="bi bi-arrow-left me-2"></span>Back to Registry
            </button>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary rounded-pill px-3" onclick="window.print()">
                    <span class="bi bi-printer me-1"></span>Print
                </button>
                <a href="api/export/students" class="btn btn-outline-primary rounded-pill px-3" target="_blank">
                    <span class="bi bi-download me-1"></span>Export
                </a>
                @if (isEditing)
                {
                    <button class="btn btn-outline-secondary rounded-pill px-3" @onclick="CancelEdit">
                        <span class="bi bi-x-lg me-1"></span>Cancel
                    </button>
                    <button class="btn btn-success rounded-pill px-4" @onclick="SaveEdit">
                        <span class="bi bi-check-lg me-1"></span>Save Changes
                    </button>
                }
                else
                {
                    <button class="btn btn-primary rounded-pill px-4" @onclick="StartEdit" disabled="@(primaryForm == null)">
                        <span class="bi bi-pencil me-1"></span>Edit
                    </button>
                }
                <button class="btn btn-outline-danger rounded-pill px-3" @onclick="ShowDeleteConfirm">
                    <span class="bi bi-trash me-1"></span>Delete
                </button>
            </div>
        </div>

        @if (showToast)
        {
            <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
                <span class="bi bi-check-circle me-2"></span>@toastMessage
                <button type="button" class="btn-close btn-close-sm" @onclick="() => showToast = false"></button>
            </div>
        }

        <!-- Profile Header Card -->
        <div class="card border-0 mb-4 p-4 card-no-hover" style="background: linear-gradient(135deg, var(--srcc-navy) 0%, var(--srcc-navy-light) 100%);">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-white bg-opacity-25 text-white d-flex align-items-center justify-content-center me-4" style="width: 80px; height: 80px; font-size: 2rem; font-weight: 700;">
                    @student.StudentName.Substring(0, 1).ToUpper()
                </div>
                <div class="text-white">
                    <h2 class="fw-bold mb-1">@student.StudentName</h2>
                    <div class="d-flex gap-3 flex-wrap">
                        @if (!string.IsNullOrEmpty(student.RollNumber))
                        {
                            <span class="badge bg-white bg-opacity-25 px-3 py-2"><span class="bi bi-hash me-1"></span>@student.RollNumber</span>
                        }
                        @if (!string.IsNullOrEmpty(student.AadharNumber))
                        {
                            <span class="badge bg-white bg-opacity-25 px-3 py-2"><span class="bi bi-person-vcard me-1"></span>@MaskAadhar(student.AadharNumber)</span>
                        }
                        <span class="badge bg-white bg-opacity-25 px-3 py-2"><span class="bi bi-file-earmark me-1"></span>@forms.Count Form(s)</span>
                        <span class="badge bg-white bg-opacity-25 px-3 py-2"><span class="bi bi-calendar me-1"></span>Since @student.CreatedDate.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Info Cards -->
            <div class="col-lg-7">
                @if (primaryForm != null)
                {
                    <!-- Personal Info -->
                    <div class="card border-0 mb-4 card-no-hover">
                        <div class="card-header py-3">
                            <span class="bi bi-person me-2"></span>Personal Information
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @if (isEditing)
                                {
                                    <div class="col-6"><label class="small text-muted d-block">Full Name</label><input class="form-control form-control-sm" @bind="primaryForm.StudentName" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Date of Birth</label><input class="form-control form-control-sm" @bind="primaryForm.DateOfBirth" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Gender</label><input class="form-control form-control-sm" @bind="primaryForm.Gender" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Category</label><input class="form-control form-control-sm" @bind="primaryForm.Category" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Blood Group</label><input class="form-control form-control-sm" @bind="primaryForm.BloodGroup" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Religion</label><input class="form-control form-control-sm" @bind="primaryForm.Religion" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Nationality</label><input class="form-control form-control-sm" @bind="primaryForm.Nationality" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Aadhar</label><input class="form-control form-control-sm" @bind="primaryForm.AadharNumber" /></div>
                                }
                                else
                                {
                                    <div class="col-6"><label class="small text-muted d-block">Full Name</label><span class="fw-semibold">@Val(primaryForm.StudentName)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Date of Birth</label><span class="fw-semibold">@Val(primaryForm.DateOfBirth)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Gender</label><span class="fw-semibold">@Val(primaryForm.Gender)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Category</label><span class="fw-semibold">@Val(primaryForm.Category)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Blood Group</label><span class="fw-semibold">@Val(primaryForm.BloodGroup)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Religion</label><span class="fw-semibold">@Val(primaryForm.Religion)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Nationality</label><span class="fw-semibold">@Val(primaryForm.Nationality)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Aadhar</label><span class="fw-semibold font-monospace">@Val(primaryForm.AadharNumber)</span></div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Academic Info -->
                    <div class="card border-0 mb-4 card-no-hover">
                        <div class="card-header py-3">
                            <span class="bi bi-mortarboard me-2"></span>Academic Information
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @if (isEditing)
                                {
                                    <div class="col-6"><label class="small text-muted d-block">Course</label><input class="form-control form-control-sm" @bind="primaryForm.Course" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Academic Session</label><input class="form-control form-control-sm" @bind="primaryForm.AcademicSession" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">College Roll No</label><input class="form-control form-control-sm" @bind="primaryForm.CollegeRollNo" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">CUET Score</label><input class="form-control form-control-sm" @bind="primaryForm.CuetScore" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Admission Category</label><input class="form-control form-control-sm" @bind="primaryForm.AdmissionCategory" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Date of Admission</label><input class="form-control form-control-sm" @bind="primaryForm.DateOfAdmission" /></div>
                                }
                                else
                                {
                                    <div class="col-6"><label class="small text-muted d-block">Course</label><span class="fw-semibold">@Val(primaryForm.Course)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Academic Session</label><span class="fw-semibold">@Val(primaryForm.AcademicSession)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">College Roll No</label><span class="fw-semibold">@Val(primaryForm.CollegeRollNo)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">CUET Score</label><span class="fw-semibold">@Val(primaryForm.CuetScore)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Admission Category</label><span class="fw-semibold">@Val(primaryForm.AdmissionCategory)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Date of Admission</label><span class="fw-semibold">@Val(primaryForm.DateOfAdmission)</span></div>
                                }
                            </div>
                            <hr class="my-3" />
                            <div class="row g-3">
                                @if (isEditing)
                                {
                                    <div class="col-6"><label class="small text-muted d-block">12th Board</label><input class="form-control form-control-sm" @bind="primaryForm.TwelfthBoard" /></div>
                                    <div class="col-3"><label class="small text-muted d-block">12th Year</label><input class="form-control form-control-sm" @bind="primaryForm.TwelfthYear" /></div>
                                    <div class="col-3"><label class="small text-muted d-block">12th %</label><input class="form-control form-control-sm" @bind="primaryForm.TwelfthPercentage" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">10th Board</label><input class="form-control form-control-sm" @bind="primaryForm.TenthBoard" /></div>
                                    <div class="col-3"><label class="small text-muted d-block">10th Year</label><input class="form-control form-control-sm" @bind="primaryForm.TenthYear" /></div>
                                    <div class="col-3"><label class="small text-muted d-block">10th %</label><input class="form-control form-control-sm" @bind="primaryForm.TenthPercentage" /></div>
                                }
                                else
                                {
                                    <div class="col-6"><label class="small text-muted d-block">12th Board</label><span class="fw-semibold">@Val(primaryForm.TwelfthBoard)</span></div>
                                    <div class="col-3"><label class="small text-muted d-block">12th Year</label><span class="fw-semibold">@Val(primaryForm.TwelfthYear)</span></div>
                                    <div class="col-3"><label class="small text-muted d-block">12th %</label><span class="fw-semibold">@Val(primaryForm.TwelfthPercentage)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">10th Board</label><span class="fw-semibold">@Val(primaryForm.TenthBoard)</span></div>
                                    <div class="col-3"><label class="small text-muted d-block">10th Year</label><span class="fw-semibold">@Val(primaryForm.TenthYear)</span></div>
                                    <div class="col-3"><label class="small text-muted d-block">10th %</label><span class="fw-semibold">@Val(primaryForm.TenthPercentage)</span></div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Contact Info -->
                    <div class="card border-0 mb-4 card-no-hover">
                        <div class="card-header py-3">
                            <span class="bi bi-telephone me-2"></span>Contact & Address
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @if (isEditing)
                                {
                                    <div class="col-6"><label class="small text-muted d-block">Email</label><input class="form-control form-control-sm" @bind="primaryForm.Email" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Phone</label><input class="form-control form-control-sm" @bind="primaryForm.PhoneNumber" /></div>
                                    <div class="col-12"><label class="small text-muted d-block">Permanent Address</label><input class="form-control form-control-sm" @bind="primaryForm.PermanentAddress" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">State</label><input class="form-control form-control-sm" @bind="primaryForm.PermanentState" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Pincode</label><input class="form-control form-control-sm" @bind="primaryForm.PermanentPincode" /></div>
                                }
                                else
                                {
                                    <div class="col-6"><label class="small text-muted d-block">Email</label><span class="fw-semibold">@Val(primaryForm.Email)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Phone</label><span class="fw-semibold">@Val(primaryForm.PhoneNumber)</span></div>
                                    <div class="col-12"><label class="small text-muted d-block">Permanent Address</label><span class="fw-semibold">@Val(primaryForm.PermanentAddress)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">State</label><span class="fw-semibold">@Val(primaryForm.PermanentState)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Pincode</label><span class="fw-semibold">@Val(primaryForm.PermanentPincode)</span></div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Parent Info -->
                    <div class="card border-0 mb-4 card-no-hover">
                        <div class="card-header py-3">
                            <span class="bi bi-people me-2"></span>Parent / Guardian
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @if (isEditing)
                                {
                                    <div class="col-6"><label class="small text-muted d-block">Father's Name</label><input class="form-control form-control-sm" @bind="primaryForm.FatherName" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Mother's Name</label><input class="form-control form-control-sm" @bind="primaryForm.MotherName" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Father's Occupation</label><input class="form-control form-control-sm" @bind="primaryForm.FatherOccupation" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Mother's Occupation</label><input class="form-control form-control-sm" @bind="primaryForm.MotherOccupation" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Father's Mobile</label><input class="form-control form-control-sm" @bind="primaryForm.FatherMobile" /></div>
                                    <div class="col-6"><label class="small text-muted d-block">Mother's Mobile</label><input class="form-control form-control-sm" @bind="primaryForm.MotherMobile" /></div>
                                }
                                else
                                {
                                    <div class="col-6"><label class="small text-muted d-block">Father's Name</label><span class="fw-semibold">@Val(primaryForm.FatherName)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Mother's Name</label><span class="fw-semibold">@Val(primaryForm.MotherName)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Father's Occupation</label><span class="fw-semibold">@Val(primaryForm.FatherOccupation)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Mother's Occupation</label><span class="fw-semibold">@Val(primaryForm.MotherOccupation)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Father's Mobile</label><span class="fw-semibold">@Val(primaryForm.FatherMobile)</span></div>
                                    <div class="col-6"><label class="small text-muted d-block">Mother's Mobile</label><span class="fw-semibold">@Val(primaryForm.MotherMobile)</span></div>
                                    @if (!string.IsNullOrEmpty(primaryForm.GuardianName))
                                    {
                                        <div class="col-6"><label class="small text-muted d-block">Guardian</label><span class="fw-semibold">@primaryForm.GuardianName</span></div>
                                        <div class="col-6"><label class="small text-muted d-block">Relation</label><span class="fw-semibold">@Val(primaryForm.GuardianRelation)</span></div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card border-0 p-5 text-center card-no-hover">
                        <span class="bi bi-info-circle fs-1 text-muted opacity-25 d-block mb-3"></span>
                        <p class="text-muted">No verified form data available. Upload and verify a form to see detailed information.</p>
                    </div>
                }
            </div>

            <!-- Right Column: Data Completeness + Forms -->
            <div class="col-lg-5">
                <!-- Data Completeness -->
                @if (primaryForm != null)
                {
                    <div class="card border-0 mb-4 card-no-hover">
                        <div class="card-header py-3">
                            <span class="bi bi-bar-chart me-2"></span>Data Completeness
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary small">Fields populated</span>
                                <span class="fw-bold">@FilledFields / @TotalFields</span>
                            </div>
                            <div class="progress" style="height: 10px; border-radius: 10px;">
                                <div class="progress-bar bg-success" style="width: @CompletenessPercent%; border-radius: 10px;"></div>
                            </div>
                            <div class="text-end small text-muted mt-1">@CompletenessPercent%</div>
                        </div>
                    </div>
                }

                <!-- Linked Forms -->
                <div class="card border-0 card-no-hover">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <span><span class="bi bi-file-earmark-text me-2"></span>Linked Forms</span>
                        <span class="badge bg-primary rounded-pill">@forms.Count</span>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var f in forms)
                        {
                            <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" @onclick='() => Navigation.NavigateTo($"forms/{f.Id}")'>
                                <div>
                                    <div class="fw-semibold small">@f.Filename</div>
                                    <span class="text-muted" style="font-size: 0.75rem;">@f.UploadDate.ToString("dd MMM yyyy") · @(f.Course ?? "—")</span>
                                </div>
                                @switch (f.Status)
                                {
                                    case FormStatus.Verified:
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3">Verified</span>
                                        break;
                                    case FormStatus.Extracted:
                                        <span class="badge bg-info-subtle text-info rounded-pill px-3">Extracted</span>
                                        break;
                                    default:
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3">@f.Status</span>
                                        break;
                                }
                            </button>
                        }
                        @if (!forms.Any())
                        {
                            <div class="list-group-item text-center text-muted py-4 small">No forms linked yet</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirm -->
@if (showDelete)
{
    <div class="modal-overlay" @onclick="() => showDelete = false">
        <div class="modal-dialog-custom" @onclick:stopPropagation>
            <h5 class="fw-bold mb-3"><span class="bi bi-exclamation-triangle text-danger me-2"></span>Delete Student</h5>
            <p class="text-secondary">This will permanently delete <strong>@student?.StudentName</strong> and all linked forms. This cannot be undone.</p>
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-light" @onclick="() => showDelete = false">Cancel</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete">Delete Permanently</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private StudentProfile? student;
    private List<AdmissionForm> forms = new();
    private AdmissionForm? primaryForm;
    private bool showDelete;
    private bool isEditing;
    private bool showToast;
    private string toastMessage = "";

    private int FilledFields;
    private int TotalFields;
    private int CompletenessPercent;

    protected override async Task OnInitializedAsync()
    {
        student = await DbContext.StudentProfiles
            .Include(s => s.Forms)
            .FirstOrDefaultAsync(s => s.Id == Id);

        if (student != null)
        {
            forms = student.Forms.OrderByDescending(f => f.UploadDate).ToList();
            primaryForm = forms.FirstOrDefault(f => f.Status == FormStatus.Verified) ?? forms.FirstOrDefault();
            if (primaryForm != null) CountFilledFields(primaryForm);
        }
    }

    private void CountFilledFields(AdmissionForm f)
    {
        var props = typeof(AdmissionForm).GetProperties()
            .Where(p => p.PropertyType == typeof(string) && p.Name != "Id" && !p.Name.Contains("Sync") && !p.Name.Contains("Server") && p.Name != "Filename" && p.Name != "FilePath" && p.Name != "ExtractedDataJson" && p.Name != "OcrProvider");
        TotalFields = props.Count();
        FilledFields = props.Count(p => !string.IsNullOrWhiteSpace(p.GetValue(f) as string));
        CompletenessPercent = TotalFields > 0 ? (int)Math.Round(100.0 * FilledFields / TotalFields) : 0;
    }

    private string Val(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
    private string MaskAadhar(string? a) => string.IsNullOrEmpty(a) || a.Length < 8 ? (a ?? "—") : "XXXX-XXXX-" + a[^4..];

    private void StartEdit() => isEditing = true;
    private void CancelEdit()
    {
        isEditing = false;
        // Reload to discard changes
        Navigation.NavigateTo($"students/{Id}", forceLoad: true);
    }

    private async Task SaveEdit()
    {
        if (primaryForm != null)
        {
            primaryForm.LastModifiedUtc = DateTime.UtcNow;
            // Sync student profile name if changed
            if (student != null && primaryForm.StudentName != student.StudentName)
            {
                student.StudentName = primaryForm.StudentName;
                student.UpdatedDate = DateTime.UtcNow;
            }
            await DbContext.SaveChangesAsync();
            isEditing = false;
            CountFilledFields(primaryForm);
            toastMessage = "Changes saved successfully!";
            showToast = true;
        }
    }

    private void ShowDeleteConfirm() => showDelete = true;
    private async Task ConfirmDelete()
    {
        if (student != null)
        {
            DbContext.StudentProfiles.Remove(student);
            await DbContext.SaveChangesAsync();
            Navigation.NavigateTo("students");
        }
    }
}
