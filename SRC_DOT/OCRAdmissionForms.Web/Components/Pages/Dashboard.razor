@page "/"
@using Microsoft.EntityFrameworkCore
@using OCRAdmissionForms.Core.Entities
@using OCRAdmissionForms.Core.Enums
@using OCRAdmissionForms.Infrastructure.Data
@inject AppDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Dashboard - SRCC Student DMS</PageTitle>

<div class="dashboard-container">
    <!-- Header with Gradient -->
    <!-- Header with Glassmorphism -->
    <div class="card border-0 mb-4 p-5 text-white glass-effect" style="background: linear-gradient(135deg, var(--srcc-navy) 0%, var(--srcc-navy-light) 100%); position: relative; overflow: hidden;">
        <div style="position: absolute; top: -10%; right: -5%; opacity: 0.1; font-size: 15rem; transform: rotate(-15deg);">
            <span class="bi bi-mortarboard"></span>
        </div>
        <div class="row align-items-center position-relative">
            <div class="col">
                <h1 class="fw-bold mb-1" style="font-size: 2.5rem; letter-spacing: -1px;">SRCC Student DMS</h1>
                <p class="mb-0 opacity-75 fs-5">Advanced Integrated Student Records & OCR Platform</p>
                <div class="mt-4 d-flex gap-3">
                    <span class="badge rounded-pill bg-white bg-opacity-25 px-3 py-2"><span class="bi bi-shield-check me-2"></span>Secure Interface</span>
                    <span class="badge rounded-pill bg-white bg-opacity-25 px-3 py-2"><span class="bi bi-hdd-network me-2"></span>Database Synced</span>
                </div>
            </div>
            <div class="col-auto d-none d-lg-block">
                <div class="bg-white bg-opacity-10 p-4 rounded-4 border border-white border-opacity-10">
                    <span class="bi bi-person-badge-fill" style="font-size: 4rem;"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-widget card border-0 h-100 cursor-pointer" @onclick='() => Navigation.NavigateTo("search")'>
                <div class="card-body p-4 text-center">
                    <div class="rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background-color: #eff6ff; color: #3b82f6;">
                        <span class="bi bi-file-earmark-text fs-2"></span>
                    </div>
                    <h2 class="fw-bold mb-1 text-primary">@TotalForms</h2>
                    <p class="text-secondary small fw-medium mb-0 uppercase letter-spacing-1">Total Admissions</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-widget card border-0 h-100 cursor-pointer" @onclick='() => Navigation.NavigateTo("search?status=Verified")'>
                <div class="card-body p-4 text-center">
                    <div class="rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background-color: #ecfdf5; color: #10b981;">
                        <span class="bi bi-check-circle fs-2"></span>
                    </div>
                    <h2 class="fw-bold mb-1 text-success">@VerifiedForms</h2>
                    <p class="text-secondary small fw-medium mb-0 uppercase letter-spacing-1">Verified Records</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-widget card border-0 h-100 cursor-pointer" @onclick='() => Navigation.NavigateTo("search?status=Pending")'>
                <div class="card-body p-4 text-center">
                    <div class="rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background-color: #fffbeb; color: #f59e0b;">
                        <span class="bi bi-clock-history fs-2"></span>
                    </div>
                    <h2 class="fw-bold mb-1 text-warning">@PendingForms</h2>
                    <p class="text-secondary small fw-medium mb-0 uppercase letter-spacing-1">Pending Review</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-widget card border-0 h-100 cursor-pointer" @onclick='() => Navigation.NavigateTo("students")'>
                <div class="card-body p-4 text-center">
                    <div class="rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background-color: #f5f3ff; color: #8b5cf6;">
                        <span class="bi bi-people fs-2"></span>
                    </div>
                    <h2 class="fw-bold mb-1" style="color: #8b5cf6 !important;">@StudentProfiles</h2>
                    <p class="text-secondary small fw-medium mb-0 uppercase letter-spacing-1">Student Profiles</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-widget card border-0 h-100 cursor-pointer" @onclick='() => Navigation.NavigateTo("search?Status=Extracted")'>
                <div class="card-body p-4 text-center">
                    <div class="rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background-color: #fff7ed; color: #f97316;">
                        <span class="bi bi-calendar-date fs-2"></span>
                    </div>
                    <h2 class="fw-bold mb-1" style="color: #f97316 !important;">@TodayUploads</h2>
                    <p class="text-secondary small fw-medium mb-0 uppercase letter-spacing-1">Today's Uploads</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-widget card border-0 h-100 cursor-pointer" @onclick='() => Navigation.NavigateTo("search?Status=Error")'>
                <div class="card-body p-4 text-center">
                    <div class="rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background-color: #fef2f2; color: #ef4444;">
                        <span class="bi bi-exclamation-triangle fs-2"></span>
                    </div>
                    <h2 class="fw-bold mb-1 text-danger">@ErrorCount</h2>
                    <p class="text-secondary small fw-medium mb-0 uppercase letter-spacing-1">Errors</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Verification Rate -->
    <div class="card border-0 shadow-sm mb-4 p-4 card-no-hover">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold text-secondary small text-uppercase">Overall Verification Rate</span>
            <span class="fw-bold text-primary fs-5">@(TotalForms > 0 ? (VerifiedForms * 100 / TotalForms) : 0)%</span>
        </div>
        <div class="progress" style="height: 8px;">
            <div class="progress-bar bg-success" role="progressbar" style="width: @(TotalForms > 0 ? (VerifiedForms * 100 / TotalForms) : 0)%"></div>
        </div>
    </div>

    <!-- Quick Actions & Secondary Stats -->
    <div class="row g-4 mb-5">
        <div class="col-md-7">
            <div class="card border-0 glass-effect p-4 h-100">
                <h4 class="fw-bold mb-4 text-primary-emphasis"><span class="bi bi-lightning-charge-fill me-2 text-warning"></span>Command Center</h4>
                <div class="row g-3">
                    <div class="col-6">
                        <button class="btn btn-primary w-100 py-3 rounded-4 d-flex flex-column align-items-center" @onclick='() => Navigation.NavigateTo("upload")'>
                            <span class="bi bi-cloud-upload fs-3 mb-2"></span>
                            <span>Upload Records</span>
                        </button>
                    </div>
                    <div class="col-6">
                        <button class="btn btn-outline-primary w-100 py-3 rounded-4 d-flex flex-column align-items-center border-2" @onclick='() => Navigation.NavigateTo("search")'>
                            <span class="bi bi-search fs-3 mb-2"></span>
                            <span>Search Registry</span>
                        </button>
                    </div>
                    <div class="col-6">
                        <button class="btn btn-outline-primary w-100 py-3 rounded-4 d-flex flex-column align-items-center border-2" @onclick='() => Navigation.NavigateTo("batch-upload")'>
                            <span class="bi bi-collection fs-3 mb-2"></span>
                            <span>Batch Upload</span>
                        </button>
                    </div>
                    <div class="col-6">
                        <button class="btn btn-outline-primary w-100 py-3 rounded-4 d-flex flex-column align-items-center border-2" @onclick='() => Navigation.NavigateTo("export")'>
                            <span class="bi bi-download fs-3 mb-2"></span>
                            <span>Export Data</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card border-0 bg-white p-4 h-100">
                <h4 class="fw-bold mb-4 text-primary-emphasis"><span class="bi bi-cpu me-2 text-primary"></span>Engine Status</h4>
                <div class="space-y-3">
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-light mb-3">
                        <div class="d-flex align-items-center">
                            <span class="bi bi-layers text-info me-3 fs-4"></span>
                            <span class="text-secondary fw-medium">OCR Buffer</span>
                        </div>
                        <span class="badge bg-info-subtle text-info fs-6">@ExtractedCount Forms</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-light">
                        <div class="d-flex align-items-center">
                            <span class="bi bi-exclamation-octagon text-danger me-3 fs-4"></span>
                            <span class="text-secondary fw-medium">Sync Errors</span>
                        </div>
                        <span class="badge bg-danger-subtle text-danger fs-6">@ErrorCount Issues</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity Table -->
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-primary-emphasis"><span class="bi bi-clock-history me-2"></span>Recent Forms</h5>
            <a href="forms" class="btn btn-sm btn-outline-primary rounded-pill px-3">View All →</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Student Name</th>
                            <th>Course</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var form in RecentForms)
                        {
                            <tr class="cursor-pointer" @onclick='() => Navigation.NavigateTo($"forms/{form.Id}")'>
                                <td class="ps-4">@form.Id</td>
                                <td class="fw-semibold">@form.StudentName</td>
                                <td>@form.Course</td>
                                <td>@form.UploadDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @switch (form.Status)
                                    {
                                        case FormStatus.Verified:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">Verified</span>
                                            break;
                                        case FormStatus.Extracted:
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2">Extracted</span>
                                            break;
                                        case FormStatus.Error:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">Error</span>
                                            break;
                                        default:
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">@form.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-light border" @onclick='() => Navigation.NavigateTo($"forms/{form.Id}")'>View Details</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private int TotalForms = 0;
    private int VerifiedForms = 0;
    private int PendingForms = 0;
    private int StudentProfiles = 0;
    private int ExtractedCount = 0;
    private int ErrorCount = 0;
    private int TodayUploads = 0;
    private List<AdmissionForm> RecentForms = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await DbContext.Database.EnsureCreatedAsync();

            TotalForms = await DbContext.AdmissionForms.CountAsync();
            VerifiedForms = await DbContext.AdmissionForms.CountAsync(f => f.Status == FormStatus.Verified);
            PendingForms = await DbContext.AdmissionForms.CountAsync(f => f.Status == FormStatus.Uploaded || f.Status == FormStatus.Extracting);
            ExtractedCount = await DbContext.AdmissionForms.CountAsync(f => f.Status == FormStatus.Extracted);
            ErrorCount = await DbContext.AdmissionForms.CountAsync(f => f.Status == FormStatus.Error);
            TodayUploads = await DbContext.AdmissionForms.CountAsync(f => f.UploadDate.Date == DateTime.Today);
            
            StudentProfiles = await DbContext.StudentProfiles.CountAsync();

            RecentForms = await DbContext.AdmissionForms
                .OrderByDescending(f => f.UploadDate)
                .Take(10)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"DB Error: {ex.Message}");
        }
    }
}
