@page "/forms/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using OCRAdmissionForms.Core.Entities
@using OCRAdmissionForms.Core.Enums
@using OCRAdmissionForms.Infrastructure.Data
@inject AppDbContext DbContext
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment

<PageTitle>Form Details - @(form?.StudentName ?? Id.ToString())</PageTitle>

@if (form == null)
{
    <div class="p-5 text-center">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3">Loading form data...</p>
    </div>
}
else
{
    <div class="detail-container h-100 d-flex flex-column" style="margin: -2rem;">
        <!-- Top Toolbar -->
        <div class="bg-white border-bottom px-4 py-2 d-flex justify-content-between align-items-center" style="z-index: 10;">
            <div class="d-flex align-items-center">
                <button class="btn btn-sm btn-outline-secondary me-3" @onclick='() => Navigation.NavigateTo("forms")'>
                    <span class="bi bi-arrow-left me-1"></span> Back
                </button>
                <h5 class="mb-0 fw-bold">Verification: <span class="text-primary">@form.Filename</span></h5>
                @switch (form.Status)
                {
                    case FormStatus.Verified:
                        <span class="badge bg-success-subtle text-success ms-3 px-3 py-2">✓ Verified</span>
                        break;
                    case FormStatus.Extracted:
                        <span class="badge bg-info-subtle text-info ms-3 px-3 py-2">Extracted</span>
                        break;
                    default:
                        <span class="badge bg-warning-subtle text-warning ms-3 px-3 py-2">@form.Status</span>
                        break;
                }
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-secondary" onclick="window.print()">
                    <span class="bi bi-printer me-1"></span> Print
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CopyFields">
                    <span class="bi bi-clipboard me-1"></span> Copy Fields
                </button>
                <div class="vr mx-1"></div>
                <button class="btn btn-sm btn-outline-danger" @onclick="ShowDeleteConfirm">
                    <span class="bi bi-trash me-1"></span> Delete
                </button>
                <button class="btn btn-sm btn-outline-info" @onclick="ReExtract">
                    <span class="bi bi-arrow-repeat me-1"></span> Re-extract
                </button>
                <button class="btn btn-sm btn-success px-4" @onclick="SaveChanges">
                    <span class="bi bi-check-lg me-1"></span> Verify & Save
                </button>
            </div>
        </div>

        <div class="flex-grow-1 d-flex overflow-hidden">
            <!-- Left Panel: Preview -->
            <div class="preview-panel bg-dark d-flex flex-column" style="width: 50%; border-right: 1px solid #334155;">
                <div class="bg-secondary bg-opacity-25 p-2 d-flex justify-content-center gap-2 border-bottom border-secondary border-opacity-25">
                    <button class="btn btn-xs btn-outline-light py-0 px-2" @onclick="ZoomOut">-</button>
                    <span class="text-white-50 small">@zoomLevel%</span>
                    <button class="btn btn-xs btn-outline-light py-0 px-2" @onclick="ZoomIn">+</button>
                    <button class="btn btn-xs btn-outline-light py-0 px-2 ms-2" @onclick="ZoomReset">Fit</button>
                </div>
                <div class="flex-grow-1 overflow-auto p-4 d-flex justify-content-center align-items-start bg-black">
                    @if (isPdf)
                    {
                        <embed src="/uploads/@form.FilePath" type="application/pdf" width="100%" height="100%" />
                    }
                    else
                    {
                        <img src="/uploads/@form.FilePath" style="width: @(zoomLevel)%; transition: width 0.2s;" />
                    }
                </div>
            </div>

            <!-- Right Panel: Fields -->
            <div class="fields-panel bg-white overflow-auto p-4" style="width: 50%;">
                <div class="alert alert-info py-2 small mb-4">
                    <span class="bi bi-info-circle me-2"></span>Review extracted data against the document on the left.
                </div>

                <div class="form-sections">
                    <!-- ACADEMIC & ADMISSION -->
                    <div class="section-header">ACADEMIC & ADMISSION</div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label">Academic Session</label>
                            <input class="form-control form-control-sm" @bind="form.AcademicSession" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Course</label>
                            <input class="form-control form-control-sm" @bind="form.Course" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Admission Category</label>
                            <input class="form-control form-control-sm" @bind="form.AdmissionCategory" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">DU Portal Form Number</label>
                            <input class="form-control form-control-sm" @bind="form.DuPortalFormNumber" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">College Roll No</label>
                            <input class="form-control form-control-sm" @bind="form.CollegeRollNo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">CUET Total Score</label>
                            <input class="form-control form-control-sm" @bind="form.CuetScore" />
                        </div>
                         <div class="col-md-4">
                            <label class="form-label">Date of Admission</label>
                            <input class="form-control form-control-sm" @bind="form.DateOfAdmission" />
                        </div>
                    </div>

                    <!-- PERSONAL INFORMATION -->
                    <div class="section-header">PERSONAL INFORMATION</div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label class="form-label">Full Name</label>
                            <input class="form-control form-control-sm" @bind="form.StudentName" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">First Name</label>
                            <input class="form-control form-control-sm" @bind="form.FirstName" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Middle Name</label>
                            <input class="form-control form-control-sm" @bind="form.MiddleName" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Surname</label>
                            <input class="form-control form-control-sm" @bind="form.Surname" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Date of Birth</label>
                            <input class="form-control form-control-sm" @bind="form.DateOfBirth" placeholder="DD/MM/YYYY" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Gender</label>
                            <input class="form-control form-control-sm" @bind="form.Gender" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Category</label>
                            <input class="form-control form-control-sm" @bind="form.Category" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Aadhar Number</label>
                            <input class="form-control form-control-sm" @bind="form.AadharNumber" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Blood Group</label>
                            <input class="form-control form-control-sm" @bind="form.BloodGroup" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Religion</label>
                            <input class="form-control form-control-sm" @bind="form.Religion" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Nationality</label>
                            <input class="form-control form-control-sm" @bind="form.Nationality" />
                        </div>
                         <div class="col-md-6">
                            <label class="form-label">Annual Family Income</label>
                            <input class="form-control form-control-sm" @bind="form.AnnualIncome" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Below Poverty Line?</label>
                            <input class="form-control form-control-sm" @bind="form.BelowPovertyLine" />
                        </div>
                    </div>

                    <!-- PARENT INFORMATION -->
                    <div class="section-header">PARENT INFORMATION</div>
                    <div class="row g-3 mb-4">
                        <!-- Father's Info -->
                        <div class="col-md-6">
                            <label class="form-label">Father's Name</label>
                            <input class="form-control form-control-sm" @bind="form.FatherName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mother's Name</label>
                            <input class="form-control form-control-sm" @bind="form.MotherName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Father's Occupation</label>
                            <input class="form-control form-control-sm" @bind="form.FatherOccupation" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mother's Occupation</label>
                            <input class="form-control form-control-sm" @bind="form.MotherOccupation" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Father's Annual Income</label>
                            <input class="form-control form-control-sm" @bind="form.FatherAnnualIncome" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mother's Annual Income</label>
                            <input class="form-control form-control-sm" @bind="form.MotherAnnualIncome" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Father's Mobile</label>
                            <input class="form-control form-control-sm" @bind="form.FatherMobile" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mother's Mobile</label>
                            <input class="form-control form-control-sm" @bind="form.MotherMobile" />
                        </div>
                    </div>

                    <!-- GUARDIAN INFORMATION -->
                    <div class="section-header">GUARDIAN INFORMATION</div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label">Guardian Name</label>
                            <input class="form-control form-control-sm" @bind="form.GuardianName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Relation</label>
                            <input class="form-control form-control-sm" @bind="form.GuardianRelation" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Guardian Mobile</label>
                            <input class="form-control form-control-sm" @bind="form.GuardianMobile" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Guardian Email</label>
                            <input class="form-control form-control-sm" @bind="form.GuardianEmail" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Guardian Address</label>
                            <textarea class="form-control form-control-sm" @bind="form.GuardianAddress"></textarea>
                        </div>
                    </div>

                    <!-- CONTACT & ADDRESS DETAILS -->
                    <div class="section-header">CONTACT & ADDRESS DETAILS</div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input class="form-control form-control-sm" @bind="form.Email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mobile Number</label>
                            <input class="form-control form-control-sm" @bind="form.PhoneNumber" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Permanent Address</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="form.PermanentAddress"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">State</label>
                            <input class="form-control form-control-sm" @bind="form.PermanentState" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Pincode</label>
                            <input class="form-control form-control-sm" @bind="form.PermanentPincode" />
                        </div>
                    </div>

                    <!-- ACADEMIC HISTORY -->
                    <div class="section-header">ACADEMIC HISTORY</div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                             <div class="small fw-bold text-secondary mb-2">Class XII (Senior Secondary)</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Board</label>
                            <input class="form-control form-control-sm" @bind="form.TwelfthBoard" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Year</label>
                            <input class="form-control form-control-sm" @bind="form.TwelfthYear" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Percentage</label>
                            <input class="form-control form-control-sm" @bind="form.TwelfthPercentage" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Institution</label>
                            <input class="form-control form-control-sm" @bind="form.TwelfthInstitution" />
                        </div>

                        <div class="col-md-12 mt-3">
                             <div class="small fw-bold text-secondary mb-2">Class X (Secondary)</div>
                        </div>
                         <div class="col-md-6">
                            <label class="form-label">Board</label>
                            <input class="form-control form-control-sm" @bind="form.TenthBoard" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Year</label>
                            <input class="form-control form-control-sm" @bind="form.TenthYear" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Percentage</label>
                            <input class="form-control form-control-sm" @bind="form.TenthPercentage" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">School Name</label>
                            <input class="form-control form-control-sm" @bind="form.TenthSchool" />
                        </div>
                        
                        <div class="col-md-12 mt-3">
                            <label class="form-label">Hindi Studied Upto (Class)</label>
                            <input class="form-control form-control-sm" @bind="form.HindiStudiedUpto" />
                        </div>
                    </div>

                    <!-- CUET SUBJECT DETAILS -->
                    <div class="section-header">CUET SUBJECT DETAILS</div>
                    <div class="table-responsive mb-4">
                        <table class="table table-sm table-bordered">
                            <thead class="bg-light">
                                <tr>
                                    <th>Subject</th>
                                    <th>Max Score</th>
                                    <th>Score Obtained</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 1; i <= 4; i++)
                                {
                                    var idx = i;
                                    <tr>
                                        <td><input class="form-control form-control-xs border-0" value="@GetCuetSubject(idx)" @onchange="(e) => SetCuetSubject(idx, e.Value?.ToString())" /></td>
                                        <td><input class="form-control form-control-xs border-0" value="@GetCuetTotal(idx)" @onchange="(e) => SetCuetTotal(idx, e.Value?.ToString())" /></td>
                                        <td><input class="form-control form-control-xs border-0" value="@GetCuetObtained(idx)" @onchange="(e) => SetCuetObtained(idx, e.Value?.ToString())" /></td>
                                    </tr>
                                }
                                <tr class="table-info">
                                    <td class="fw-bold">Aggregate Totals</td>
                                    <td><input class="form-control form-control-xs border-0 fw-bold bg-transparent" @bind="form.CuetTotalScoreAll" /></td>
                                    <td><input class="form-control form-control-xs border-0 fw-bold bg-transparent" @bind="form.CuetScoreObtainedAll" /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- DOCUMENT CHECKLIST -->
                    <div class="section-header">DOCUMENT CHECKLIST</div>
                    <div class="row g-2 mb-4">
                        <div class="col-md-6"><div class="form-check small"><input type="checkbox" class="form-check-input" @bind="form.DocAdmissionForm"> <label class="form-check-label">Admission Form</label></div></div>
                        <div class="col-md-6"><div class="form-check small"><input type="checkbox" class="form-check-input" @bind="form.DocCuetScorecard"> <label class="form-check-label">CUET Scorecard</label></div></div>
                        <div class="col-md-6"><div class="form-check small"><input type="checkbox" class="form-check-input" @bind="form.DocClassXiiMarksheet"> <label class="form-check-label">Class XII Marksheet</label></div></div>
                        <div class="col-md-6"><div class="form-check small"><input type="checkbox" class="form-check-input" @bind="form.DocClassXCertificate"> <label class="form-check-label">Class X Certificate</label></div></div>
                        <div class="col-md-6"><div class="form-check small"><input type="checkbox" class="form-check-input" @bind="form.DocCasteCertificate"> <label class="form-check-label">Caste Certificate</label></div></div>
                        <div class="col-md-6"><div class="form-check small"><input type="checkbox" class="form-check-input" @bind="form.DocAadharCard"> <label class="form-check-label">Aadhar Card</label></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* Toast *@
@if (showToast)
{
    <div class="toast-container">
        <div class="toast-msg toast-success">
            <span class="bi bi-check-circle me-2"></span>@toastMessage
        </div>
    </div>
}

@* Delete confirmation *@
@if (showDelete)
{
    <div class="modal-overlay" @onclick="() => showDelete = false">
        <div class="modal-dialog-custom" @onclick:stopPropagation>
            <h5 class="fw-bold mb-3"><span class="bi bi-exclamation-triangle text-danger me-2"></span>Delete Form</h5>
            <p class="text-secondary">Permanently delete <strong>@form?.Filename</strong>? This cannot be undone.</p>
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-light" @onclick="() => showDelete = false">Cancel</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
}

<style>
    .section-header {
        background-color: #f1f5f9;
        color: var(--srcc-navy);
        padding: 4px 12px;
        font-weight: 700;
        font-size: 0.75rem;
        border-radius: 4px;
        margin-bottom: 1rem;
        letter-spacing: 0.5px;
    }
    .form-control-xs {
        padding: 0.1rem 0.4rem;
        font-size: 0.8rem;
    }
    .form-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 0.25rem;
    }
    .form-control-sm, .form-select-sm {
        border-color: #e2e8f0;
    }
    .form-control-sm:focus {
        border-color: var(--srcc-navy);
        box-shadow: 0 0 0 0.2rem rgba(30, 58, 95, 0.1);
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    private AdmissionForm? form;
    private int zoomLevel = 80;
    private bool isPdf = false;
    private bool showToast = false;
    private string toastMessage = "";
    private bool showDelete = false;

    protected override async Task OnInitializedAsync()
    {
        form = await DbContext.AdmissionForms.FindAsync(Id);
        if (form != null)
        {
            isPdf = form.FilePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
        }
    }

    private void ZoomIn() => zoomLevel = Math.Min(200, zoomLevel + 10);
    private void ZoomOut() => zoomLevel = Math.Max(20, zoomLevel - 10);
    private void ZoomReset() => zoomLevel = 80;

    private async Task SaveChanges()
    {
        if (form != null)
        {
            form.Status = FormStatus.Verified;
            form.LastModifiedUtc = DateTime.UtcNow;
            await DbContext.SaveChangesAsync();

            // Auto-create student profile if not linked
            if (form.StudentProfileId == null && !string.IsNullOrWhiteSpace(form.StudentName))
            {
                var existingProfile = await DbContext.StudentProfiles
                    .FirstOrDefaultAsync(p => p.StudentName == form.StudentName);
                if (existingProfile == null)
                {
                    existingProfile = new StudentProfile
                    {
                        StudentName = form.StudentName,
                        AadharNumber = form.AadharNumber,
                        RollNumber = form.CollegeRollNo,
                        CreatedDate = DateTime.UtcNow,
                        UpdatedDate = DateTime.UtcNow
                    };
                    DbContext.StudentProfiles.Add(existingProfile);
                    await DbContext.SaveChangesAsync();
                }
                form.StudentProfileId = existingProfile.Id;
                await DbContext.SaveChangesAsync();
            }

            toastMessage = "Form verified and saved successfully!";
            showToast = true;
            StateHasChanged();
            await Task.Delay(2000);
            showToast = false;
            Navigation.NavigateTo("forms");
        }
    }

    private void ShowDeleteConfirm() => showDelete = true;
    private async Task ConfirmDelete()
    {
        if (form != null)
        {
            DbContext.AdmissionForms.Remove(form);
            await DbContext.SaveChangesAsync();
            Navigation.NavigateTo("forms");
        }
    }

    private string? GetCuetSubject(int i) => i switch { 1 => form?.CuetSubject1, 2 => form?.CuetSubject2, 3 => form?.CuetSubject3, 4 => form?.CuetSubject4, _ => "" };
    private string? GetCuetTotal(int i) => i switch { 1 => form?.CuetTotalScore1, 2 => form?.CuetTotalScore2, 3 => form?.CuetTotalScore3, 4 => form?.CuetTotalScore4, _ => "" };
    private string? GetCuetObtained(int i) => i switch { 1 => form?.CuetScoreObtained1, 2 => form?.CuetScoreObtained2, 3 => form?.CuetScoreObtained3, 4 => form?.CuetScoreObtained4, _ => "" };

    private void SetCuetSubject(int i, string? val) { if (form == null) return; if (i == 1) form.CuetSubject1 = val; else if (i == 2) form.CuetSubject2 = val; else if (i == 3) form.CuetSubject3 = val; else if (i == 4) form.CuetSubject4 = val; }
    private void SetCuetTotal(int i, string? val) { if (form == null) return; if (i == 1) form.CuetTotalScore1 = val; else if (i == 2) form.CuetTotalScore2 = val; else if (i == 3) form.CuetTotalScore3 = val; else if (i == 4) form.CuetTotalScore4 = val; }
    private void SetCuetObtained(int i, string? val) { if (form == null) return; if (i == 1) form.CuetScoreObtained1 = val; else if (i == 2) form.CuetScoreObtained2 = val; else if (i == 3) form.CuetScoreObtained3 = val; else if (i == 4) form.CuetScoreObtained4 = val; }

    private void ReExtract()
    {
        Navigation.NavigateTo($"forms/{Id}", forceLoad: true);
    }

    private void CopyFields()
    {
        if (form == null) return;
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Student Name: {form.StudentName}");
        sb.AppendLine($"Course: {form.Course}");
        sb.AppendLine($"College Roll No: {form.CollegeRollNo}");
        sb.AppendLine($"Category: {form.Category}");
        sb.AppendLine($"Gender: {form.Gender}");
        sb.AppendLine($"Date of Birth: {form.DateOfBirth}");
        sb.AppendLine($"Aadhar Number: {form.AadharNumber}");
        sb.AppendLine($"Phone: {form.PhoneNumber}");
        sb.AppendLine($"Email: {form.Email}");
        sb.AppendLine($"Father's Name: {form.FatherName}");
        sb.AppendLine($"Mother's Name: {form.MotherName}");
        sb.AppendLine($"Address: {form.PermanentAddress}");
        sb.AppendLine($"CUET Score: {form.CuetScore}");
        toastMessage = "Field data copied!";
        showToast = true;
    }
}
