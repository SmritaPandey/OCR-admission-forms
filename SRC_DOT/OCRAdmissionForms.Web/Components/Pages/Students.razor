@page "/students"
@using Microsoft.EntityFrameworkCore
@using OCRAdmissionForms.Core.Entities
@using OCRAdmissionForms.Core.Enums
@using OCRAdmissionForms.Infrastructure.Data
@inject AppDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Students Registry - SRCC Student DMS</PageTitle>

<div class="container-fluid py-4">
    <!-- Premium Header -->
    <div class="card border-0 mb-4 p-4 glass-effect" style="background: linear-gradient(135deg, var(--srcc-navy) 0%, var(--srcc-navy-light) 100%);">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-0 text-white"><span class="bi bi-people-fill me-3"></span>Student Registry</h2>
                <p class="text-white opacity-75 mb-0 small">Unified database of all verified student profiles</p>
            </div>
            <div class="d-flex gap-3">
                <div class="input-group" style="width: 350px;">
                    <span class="input-group-text bg-white bg-opacity-10 border-0 text-white"><span class="bi bi-search"></span></span>
                    <input type="text" class="form-control bg-white bg-opacity-10 border-0 text-white placeholder-white" placeholder="Search by name, roll, or aadhar..." @bind="SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch" style="box-shadow: none;" />
                </div>
                <button class="btn btn-light bg-opacity-10 border-0 text-white" @onclick="Refresh">
                    <span class="bi bi-arrow-clockwise"></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Action Toolbar -->
    <div class="card border-0 shadow-sm mb-3 p-3 bg-white rounded-4 card-no-hover">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex gap-2 align-items-center">
                <span class="text-muted small fw-semibold">@TotalCount profiles</span>
                @if (SelectedIds.Any())
                {
                    <span class="badge bg-primary rounded-pill">@SelectedIds.Count selected</span>
                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="DeleteSelected">
                        <span class="bi bi-trash me-1"></span>Delete Selected
                    </button>
                }
            </div>
            <div class="d-flex gap-2 align-items-center">
                <!-- Sort -->
                <select class="form-select form-select-sm rounded-pill border-0 bg-light" style="width: 160px;" @bind="SortField" @bind:after="LoadStudents">
                    <option value="newest">Newest First</option>
                    <option value="oldest">Oldest First</option>
                    <option value="name_asc">Name A→Z</option>
                    <option value="name_desc">Name Z→A</option>
                    <option value="roll">Roll Number</option>
                </select>
                <!-- Export Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <span class="bi bi-download me-1"></span>Export
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                        <li><a class="dropdown-item" href="/api/export/students" target="_blank"><span class="bi bi-file-earmark-excel me-2 text-success"></span>Export Excel</a></li>
                        <li><a class="dropdown-item" href="/api/export/students?format=csv" target="_blank"><span class="bi bi-filetype-csv me-2 text-primary"></span>Export CSV</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(toastMessage))
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
            <span class="bi bi-check-circle me-2"></span>@toastMessage
            <button type="button" class="btn-close btn-close-sm" @onclick="() => toastMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="p-5 text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-secondary">Synchronizing registry with database...</p>
        </div>
    }
    else if (!StudentList.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-white rounded-4">
            <span class="bi bi-people fs-1 text-muted opacity-25"></span>
            <h4 class="mt-4 fw-bold">No Records Found</h4>
            <p class="text-secondary">Try adjusting your search filters or upload new forms.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white card-no-hover">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 40px;">
                                <input type="checkbox" class="form-check-input" @onchange="ToggleSelectAll" />
                            </th>
                            <th style="width: 60px;">ID</th>
                            <th>Student Name</th>
                            <th>Roll Number</th>
                            <th>Course</th>
                            <th>Status</th>
                            <th>Phone</th>
                            <th>Forms</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in StudentList)
                        {
                            <tr class="cursor-pointer" @onclick='() => Navigation.NavigateTo($"students/{item.Student.Id}")'>
                                <td class="ps-4" @onclick:stopPropagation>
                                    <input type="checkbox" class="form-check-input" checked="@SelectedIds.Contains(item.Student.Id)" @onchange="() => ToggleSelect(item.Student.Id)" />
                                </td>
                                <td class="fw-bold text-muted">#@item.Student.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; font-weight: 600;">
                                            @(string.IsNullOrEmpty(item.Student.StudentName) ? "?" : item.Student.StudentName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold">@item.Student.StudentName</div>
                                            @if (!string.IsNullOrEmpty(item.Student.AadharNumber))
                                            {
                                                <small class="text-muted font-monospace">@item.Student.AadharNumber</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border px-3 py-2 fw-medium">@(item.Student.RollNumber ?? "—")</span></td>
                                <td class="small">@(item.Course ?? "—")</td>
                                <td>
                                    @if (item.HasVerified)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">
                                            <span class="bi bi-check-circle me-1"></span>Verified
                                        </span>
                                    }
                                    else if (item.FormCount > 0)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3">Extracted</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3">No Forms</span>
                                    }
                                </td>
                                <td class="small text-muted">@(item.Phone ?? "—")</td>
                                <td><span class="badge bg-primary rounded-pill px-3">@item.FormCount</span></td>
                                <td class="text-end pe-4" @onclick:stopPropagation>
                                    <div class="d-flex gap-1 justify-content-end">
                                        <button class="btn btn-sm btn-outline-primary px-3 rounded-pill" @onclick='() => Navigation.NavigateTo($"students/{item.Student.Id}")'>
                                            View Profile
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-2" @onclick="() => DeleteStudent(item.Student.Id)">
                                            <span class="bi bi-trash"></span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center p-3">
                <span class="text-muted small">Showing @(((_currentPage - 1) * PageSize) + 1)–@(Math.Min(_currentPage * PageSize, TotalCount)) of @TotalCount</span>
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-sm btn-outline-secondary px-3" disabled="@(_currentPage <= 1)" @onclick="PrevPage">
                        <span class="bi bi-chevron-left"></span> Prev
                    </button>
                    <span class="badge bg-light text-dark border px-3 py-2">Page @_currentPage / @TotalPages</span>
                    <button class="btn btn-sm btn-outline-secondary px-3" disabled="@(_currentPage >= TotalPages)" @onclick="NextPage">
                        Next <span class="bi bi-chevron-right"></span>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
@if (showDeleteConfirm)
{
    <div class="modal-overlay" @onclick="() => showDeleteConfirm = false">
        <div class="modal-dialog-custom" @onclick:stopPropagation>
            <h5 class="fw-bold mb-3"><span class="bi bi-exclamation-triangle text-danger me-2"></span>Confirm Delete</h5>
            <p class="text-secondary">@deleteMessage</p>
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-light" @onclick="() => showDeleteConfirm = false">Cancel</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
}

<style>
    .cursor-pointer { cursor: pointer; }
    .cursor-pointer:hover { background-color: #f8f9fa !important; }
</style>

@code {
    private const int PageSize = 25;

    private class StudentDisplayItem
    {
        public StudentProfile Student { get; set; } = null!;
        public string? Course { get; set; }
        public string? Phone { get; set; }
        public bool HasVerified { get; set; }
        public int FormCount { get; set; }
    }

    private List<StudentDisplayItem> StudentList = new();
    private string SearchTerm = "";
    private string SortField = "newest";
    private bool isLoading = true;
    private int _currentPage = 1;
    private int TotalCount = 0;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalCount / PageSize));

    private HashSet<int> SelectedIds = new();
    private bool showDeleteConfirm = false;
    private string deleteMessage = "";
    private List<int> pendingDeleteIds = new();
    private string? toastMessage;

    protected override async Task OnInitializedAsync() => await LoadStudents();

    private async Task LoadStudents()
    {
        isLoading = true;
        try
        {
            var query = DbContext.StudentProfiles
                .Include(s => s.Forms)
                .AsQueryable();

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                query = query.Where(s =>
                    s.StudentName.Contains(SearchTerm) ||
                    (s.RollNumber != null && s.RollNumber.Contains(SearchTerm)) ||
                    (s.AadharNumber != null && s.AadharNumber.Contains(SearchTerm)));
            }

            TotalCount = await query.CountAsync();

            query = SortField switch
            {
                "oldest" => query.OrderBy(s => s.CreatedDate),
                "name_asc" => query.OrderBy(s => s.StudentName),
                "name_desc" => query.OrderByDescending(s => s.StudentName),
                "roll" => query.OrderBy(s => s.RollNumber),
                _ => query.OrderByDescending(s => s.CreatedDate)
            };

            var students = await query
                .Skip((_currentPage - 1) * PageSize)
                .Take(PageSize)
                .ToListAsync();

            StudentList = students.Select(s =>
            {
                var verifiedForm = s.Forms.FirstOrDefault(f => f.Status == FormStatus.Verified);
                var latestForm = verifiedForm ?? s.Forms.OrderByDescending(f => f.UploadDate).FirstOrDefault();
                return new StudentDisplayItem
                {
                    Student = s,
                    Course = latestForm?.Course,
                    Phone = latestForm?.PhoneNumber,
                    HasVerified = verifiedForm != null,
                    FormCount = s.Forms.Count
                };
            }).ToList();

            SelectedIds.Clear();
        }
        finally { isLoading = false; }
    }

    private async Task HandleSearch(KeyboardEventArgs e) { if (e.Key == "Enter") { _currentPage = 1; await LoadStudents(); } }
    private async Task PrevPage() { if (_currentPage > 1) { _currentPage--; await LoadStudents(); } }
    private async Task NextPage() { if (_currentPage < TotalPages) { _currentPage++; await LoadStudents(); } }
    private async Task Refresh() { SearchTerm = ""; _currentPage = 1; SortField = "newest"; await LoadStudents(); }

    private void ToggleSelect(int id) { if (!SelectedIds.Remove(id)) SelectedIds.Add(id); }
    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false)) SelectedIds = StudentList.Select(s => s.Student.Id).ToHashSet();
        else SelectedIds.Clear();
    }

    private void DeleteStudent(int id)
    {
        pendingDeleteIds = new List<int> { id };
        deleteMessage = "Are you sure you want to delete this student profile? All linked forms will be unlinked.";
        showDeleteConfirm = true;
    }

    private void DeleteSelected()
    {
        pendingDeleteIds = SelectedIds.ToList();
        deleteMessage = $"Delete {pendingDeleteIds.Count} selected student profile(s)? All linked forms will be unlinked.";
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        showDeleteConfirm = false;
        var profiles = await DbContext.StudentProfiles
            .Include(s => s.Forms)
            .Where(s => pendingDeleteIds.Contains(s.Id))
            .ToListAsync();

        foreach (var p in profiles)
        {
            foreach (var f in p.Forms) f.StudentProfileId = null;
        }
        DbContext.StudentProfiles.RemoveRange(profiles);
        await DbContext.SaveChangesAsync();
        toastMessage = $"{profiles.Count} student profile(s) deleted.";
        pendingDeleteIds.Clear();
        await LoadStudents();
    }
}
