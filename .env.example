# Database
DATABASE_URL=sqlite:///./admission_forms.db

# OCR Provider (tesseract, google, azure, abbyy, ollama, gpt4, claude, tesseract-google-combined, combined)
OCR_PROVIDER=tesseract-google-combined

# Ollama Configuration (Local AI OCR - FREE)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision

# OpenAI GPT-4 Vision (Optional - requires API key)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4-vision-preview

# Anthropic Claude Vision (Optional - requires API key)
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-3-5-sonnet-20241022

# Google Cloud Vision (Optional)
GOOGLE_CLOUD_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=

# Azure Form Recognizer (Optional)
AZURE_FORM_RECOGNIZER_KEY=
AZURE_FORM_RECOGNIZER_ENDPOINT=

# AWS Textract (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,tiff,bmp

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# OCR Caching
OCR_CACHE_ENABLED=true

# Batch Processing
BATCH_MAX_CONCURRENT=5
BATCH_QUEUE_BACKEND=memory

# OCR Provider Enable Flags
# Note: tesseract-google-combined requires Google Vision credentials to be configured below
OCR_ENABLE_TESSERACT=true
OCR_ENABLE_GOOGLE_VISION=true
OCR_ENABLE_TESSERACT_GOOGLE_COMBINED=true
